# DAML-RAG Server - Zeabur生产环境配置
# 更新日期：2026-01-08
# 注意：敏感信息由Zeabur环境变量覆盖

# ============= 后端API配置 =============
# Zeabur内网通信
BACKEND_API_URL=http://fitness_php_v2.zeabur.internal:80
INTERNAL_API_TOKEN=crewai-internal-secret-2025
BACKEND_API_TIMEOUT=10.0
BACKEND_API_MAX_RETRIES=3

# ============= 缓存系统配置 =============
# 使用新缓存系统（false=旧缓存，true=新缓存）
USE_NEW_CACHE=false

# ============= Redis配置 =============
# Zeabur内网地址（阿里云镜像部署的实际内部域名）
REDIS_HOST=crpi-32sc66smgb44ld25cn-hangzhoupers.zeabur.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============= Neo4j配置 =============
# 临时使用公网端口解决内网连接超时问题（方案A）
# 原配置：bolt://crpi-32sc66smgb44ld25cn-hangzhoupers.zeabur.internal:7687
NEO4J_URI=bolt://182.92.78.183:32633
NEO4J_USER=neo4j
NEO4J_PASSWORD=build_body_2024

# ============= Qdrant配置 =============
QDRANT_HOST=crpi-32sc66smgb44ld25cn-hangzhoupers.zeabur.internal
QDRANT_PORT=6333
# 禁用gRPC连接（Zeabur环境gRPC端口6334无法连接）
QDRANT_PREFER_GRPC=false
QDRANT_GRPC_PORT=0

# ============= MySQL配置 =============
MYSQL_HOST=crpi-32sc66smgb44ld25cn-hangzhoupers.zeabur.internal
MYSQL_PORT=3306
MYSQL_USER=fitness_user
MYSQL_PASSWORD=fitness_pass
MYSQL_DATABASE=fitness_app

# ============= LLM API配置 =============
# DeepSeek (生产环境主力)
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# API池配置
USE_API_POOL=true
DUAL_MODEL_ENABLED=false
OLLAMA_ENABLED=false

# Moonshot备用
MOONSHOT_API_KEY=${MOONSHOT_API_KEY}
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# 通义千问备用
QWEN_API_KEY=${QWEN_API_KEY}
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# LLM通用配置
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ============= API Server配置 =============
PORT=8001
HOST=0.0.0.0
LOG_LEVEL=INFO

# ============= 安全配置 =============
ENABLE_RATE_LIMIT=true
ENABLE_AUTH=false
ENABLE_INPUT_VALIDATION=true
DEBUG=false
ENVIRONMENT=production
