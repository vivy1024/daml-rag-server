# DAML-RAG Server - Zeabur生产环境配置
# 更新日期：2026-01-08
# 注意：敏感信息由Zeabur环境变量覆盖

# ============= 后端API配置 =============
# Zeabur内网通信（注意：服务名使用连字符，不是下划线）
BACKEND_API_URL=http://fitness-php-v2.zeabur.internal:80
BACKEND_INTERNAL_URL=http://fitness-php-v2.zeabur.internal:80
INTERNAL_API_TOKEN=9eTioEunbkSpXJc6bEDmxEGKRrCY0p2xl2D6mhXwWaLrv-b63v2IoDYZiH4WzbDw
BACKEND_API_TIMEOUT=10.0
BACKEND_API_MAX_RETRIES=3

# ============= Internal JWT配置（权限系统重构） =============
# 内部JWT密钥（生产环境通过Zeabur环境变量覆盖，必须与PHP后端一致）
INTERNAL_JWT_SECRET=CHANGE_ME_IN_ZEABUR_ENV
# 内部JWT签发者标识
INTERNAL_JWT_ISSUER=yuzhen-auth-gateway
# 是否启用旧模式X-Internal-Token认证（迁移期保持true）
LEGACY_AUTH_ENABLED=true

# ============= 积分系统配置 =============
# 启用积分上报功能
CREDIT_REPORT_ENABLED=true

# ============= 缓存系统配置 =============
# 使用新缓存系统（false=旧缓存，true=新缓存）
USE_NEW_CACHE=false

# ============= Redis配置 =============
# 使用Zeabur自动生成的环境变量
REDIS_HOST=${FITNESS_REDIS_HOST}
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============= Neo4j配置 =============
# 使用公网端口（内网端口7687未配置为Internal服务，导致连接超时）
# 问题根因：Zeabur服务器防火墙中7687端口没有"Internal"标记
# 公网端口：32372（从Zeabur控制台Networking标签获取）
NEO4J_URI=bolt://182.92.78.183:32372
NEO4J_USER=neo4j
NEO4J_PASSWORD=build_body_2024

# ============= Qdrant配置 =============
# 使用Zeabur自动生成的环境变量
QDRANT_HOST=${FITNESS_QDRANT_HOST}
QDRANT_PORT=6333
# 禁用gRPC连接（Zeabur环境gRPC端口6334无法连接）
QDRANT_PREFER_GRPC=false
QDRANT_GRPC_PORT=0
# API Key认证（从Zeabur环境变量覆盖）
QDRANT_API_KEY=${QDRANT_API_KEY}
# 禁用HTTPS（Zeabur内网直连6333端口使用明文HTTP + API Key认证）
QDRANT_HTTPS=false

# ============= MySQL配置 =============
# 使用Zeabur自动生成的环境变量
MYSQL_HOST=${FITNESS_MYSQL_HOST}
MYSQL_PORT=3306
MYSQL_USER=fitness_user
MYSQL_PASSWORD=fitness_pass
MYSQL_DATABASE=fitness_app

# ============= LLM API配置 =============
# DeepSeek (生产环境主力)
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# API池配置
USE_API_POOL=true
DUAL_MODEL_ENABLED=false
OLLAMA_ENABLED=false

# Moonshot备用
MOONSHOT_API_KEY=${MOONSHOT_API_KEY}
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# 通义千问备用
QWEN_API_KEY=${QWEN_API_KEY}
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# LLM通用配置
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ============= API Server配置 =============
PORT=8001
HOST=0.0.0.0
LOG_LEVEL=INFO

# ============= 安全配置 =============
ENABLE_RATE_LIMIT=true
ENABLE_AUTH=true
ENABLE_INPUT_VALIDATION=true
DEBUG=false
ENVIRONMENT=production
