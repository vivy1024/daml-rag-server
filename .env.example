# DAML-RAG Server - 环境变量模板
# Python AI Service Environment Template
# 更新日期：2026-01-18
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写所有必需的环境变量值
# 3. 敏感信息（密码、API密钥）必须妥善保管
# 4. 生产环境通过Zeabur控制台配置敏感变量

# ============= 后端API配置 =============

# yuzhen-backend API基础URL
BACKEND_API_URL=http://host.docker.internal:8000

# 内部API基础URL（用于积分上报等内部服务调用）
BACKEND_INTERNAL_URL=http://host.docker.internal:8000

# 必须设置：内部API Token（必须与后端.env中的INTERNAL_API_TOKEN一致，至少32字符）
INTERNAL_API_TOKEN=

# API超时时间（秒）
BACKEND_API_TIMEOUT=10.0

# API最大重试次数
BACKEND_API_MAX_RETRIES=3

# ============= 积分系统配置 =============
# 启用积分上报功能（true=启用，false=禁用）
CREDIT_REPORT_ENABLED=true

# ============= 缓存系统配置 =============

# 使用新缓存系统（false=旧缓存，true=新缓存）
USE_NEW_CACHE=true

# ============= 会员系统配置 =============

# 启用会员权限控制
# false: 禁用，所有用户享有PREMIUM权限
# true: 启用，按实际等级限制
USE_MEMBERSHIP_CONTROL=false

# ============= Skills架构配置 =============

# 启用Skills模式（渐进式披露）
USE_SKILLS_MODE=false

# 启用Agent模式（仅ENERGY会员可用）
USE_AGENT_MODE=false

# ============= Redis配置 =============

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 可选：Redis密码（生产环境建议设置）
REDIS_PASSWORD=

# ============= Neo4j配置 =============

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# 必须设置：Neo4j数据库密码（强密码要求）
NEO4J_PASSWORD=

# ============= Qdrant配置 =============

QDRANT_HOST=qdrant
QDRANT_PORT=6333
# 可选：Qdrant API Key
QDRANT_API_KEY=
# gRPC配置
QDRANT_PREFER_GRPC=false
QDRANT_GRPC_PORT=6334
QDRANT_HTTPS=false

# ============= MySQL配置 =============

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=
# 必须设置：MySQL数据库密码（强密码要求）
MYSQL_PASSWORD=
MYSQL_DATABASE=fitness_app

# ============= Ollama配置（本地LLM）=============

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_ENABLED=false

# ============= LLM API配置 =============

# DeepSeek (主力模型)
# 必须设置：DeepSeek API密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 可选：多API Key池配置
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=
DEEPSEEK_API_KEY_5=
DEEPSEEK_API_KEY_6=
DEEPSEEK_API_KEY_7=
DEEPSEEK_API_KEY_8=
DEEPSEEK_API_KEY_9=
DEEPSEEK_API_KEY_10=

# API池配置
USE_API_POOL=true
DUAL_MODEL_ENABLED=false

# Moonshot Kimi (备用，长文本)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# 通义千问 (备用)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# LLM通用配置
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ============= API Server配置 =============

# HTTP API服务端口
PORT=8001
HOST=0.0.0.0

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============= 安全配置 =============

# 启用限流保护（防止API滥用和DDoS攻击）
ENABLE_RATE_LIMIT=true

# 启用认证（默认启用，开发环境可设为false）
ENABLE_AUTH=true

# CORS额外允许的域名（逗号分隔，默认已包含yuzhen.fit和localhost）
# CORS_EXTRA_ORIGINS=https://staging.yuzhen.fit

# 启用输入验证（防止注入攻击）
ENABLE_INPUT_VALIDATION=true

# 必须设置：加密密钥（用于加密敏感数据）
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 调试模式（生产环境必须设置为false）
DEBUG=false

# 环境类型 (development, staging, production)
ENVIRONMENT=development

# ============= 安全配置说明 =============
#
# 以下变量包含敏感信息，必须妥善保管：
# - INTERNAL_API_TOKEN: 内部API认证Token
# - NEO4J_PASSWORD: Neo4j数据库密码
# - MYSQL_PASSWORD: MySQL数据库密码
# - REDIS_PASSWORD: Redis密码
# - DEEPSEEK_API_KEY: DeepSeek API密钥
# - MOONSHOT_API_KEY: Moonshot API密钥
# - QWEN_API_KEY: 通义千问API密钥
# - ENCRYPTION_KEY: 数据加密密钥
# - QDRANT_API_KEY: Qdrant API密钥
#
# 密码强度要求：
# - 至少16字符
# - 包含大写字母(A-Z)
# - 包含小写字母(a-z)
# - 包含数字(0-9)
# - 包含特殊字符(!@#$%^&*等)
