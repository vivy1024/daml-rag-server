# Meta-Learning MCP 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============= 后端API配置 =============
# yuzhen-backend API基础URL
BACKEND_API_URL=http://host.docker.internal:8000

# 内部API Token（必须与后端 .env 中的 INTERNAL_API_TOKEN 一致）
INTERNAL_API_TOKEN=crewai-internal-secret-2025

# API超时时间（秒）
BACKEND_API_TIMEOUT=10.0

# API最大重试次数
BACKEND_API_MAX_RETRIES=3


# ============= Redis配置 =============
REDIS_HOST=fitness_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=


# ============= Neo4j配置 =============
NEO4J_URI=bolt://fitness_neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=build_body_2024


# ============= Qdrant配置 =============
QDRANT_HOST=fitness_qdrant
QDRANT_PORT=6333


# ============= MySQL配置 =============
MYSQL_HOST=fitness_mysql
MYSQL_PORT=3306
MYSQL_USER=fitness_user
MYSQL_PASSWORD=fitness_pass
MYSQL_DATABASE=fitness_app


# ============= Ollama配置 =============
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b


# ============= LLM API配置 =============
# DeepSeek (teacher模型，经济实惠)
# 支持API池轮询：配置多个Key提高可用性
DEEPSEEK_API_KEY=sk-your-main-api-key
DEEPSEEK_API_KEY_2=sk-your-backup-key-2
DEEPSEEK_API_KEY_3=sk-your-backup-key-3
DEEPSEEK_API_KEY_4=sk-your-backup-key-4
DEEPSEEK_API_KEY_5=sk-your-backup-key-5
DEEPSEEK_API_KEY_6=sk-your-backup-key-6
DEEPSEEK_API_KEY_7=sk-your-backup-key-7
DEEPSEEK_API_KEY_8=sk-your-backup-key-8
DEEPSEEK_API_KEY_9=sk-your-backup-key-9
DEEPSEEK_API_KEY_10=sk-your-backup-key-10
# 或者使用逗号分隔格式：
# DEEPSEEK_API_KEYS=sk-key1,sk-key2,sk-key3

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# API池配置
USE_API_POOL=true  # 启用API池轮询（默认true）

# 双模型选择配置（服务器环境建议禁用）
DUAL_MODEL_ENABLED=false  # 禁用双模型选择，直接使用DeepSeek

# Ollama配置（服务器环境建议禁用）
OLLAMA_ENABLED=false  # 禁用Ollama降级

# Moonshot Kimi (备用，长文本)
MOONSHOT_API_KEY=sk-TBK5kN5bGE5HeZSAv3TKKMyARKUVJ59bm5FNxeFienPLWs2Q
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# 通义千问 (备用)
QWEN_API_KEY=sk-330e2a487df54ee3be36638903e208d7
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# LLM通用配置
LLM_TIMEOUT=60.0
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7


# ============= API Server配置 =============
# HTTP API服务端口
PORT=3000
HOST=0.0.0.0

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
