        }


def _assess_fitness_level(user_profile: dict) -> dict:
    """评估训练水平"""
    if user_profile is None or not user_profile:
        return {"level": "beginner", "recommendations": ["基础动作", "轻重量"], "note": "用户档案为空，默认初级水平"}

    experience = user_profile.get("training_experience", "")

    if experience is None:
        experience = ""

    if not experience or "beginner" in experience.lower():
        return {"level": "beginner", "recommendations": ["基础动作", "轻重量"]}
    elif "advanced" in experience.lower():
        return {"level": "advanced", "recommendations": ["复合动作", "高强度"]}
    else:
        return {"level": "intermediate", "recommendations": ["渐进超负荷", "技术提升"]}


def _parse_mcp_tool_result(task_name: str, mcp_result: Any) -> dict:
    """
    解析MCP工具返回的结果并格式化为统一的结构
    
    Args:
        task_name: 任务名称
        mcp_result: MCP工具返回的原始结果
    
    Returns:
        dict: 格式化后的结果字典
    """
    try:
        # 如果是MCPToolCallResult对象
        if hasattr(mcp_result, 'success'):
            if mcp_result.success:
                # 成功结果
                parsed_result = {
                    "success": True,
                    "data": mcp_result.data,
                    "tool_name": task_name,
                    "execution_time_ms": mcp_result.execution_time_ms,
                    "timestamp": mcp_result.timestamp.isoformat() if hasattr(mcp_result.timestamp, 'isoformat') else str(mcp_result.timestamp),
                    "fallback_used": mcp_result.fallback_used
                }
                logger.debug(f"✅ MCP结果解析成功: {task_name}")
                return parsed_result
            else:
                # 失败结果（带降级）
                parsed_result = {
                    "success": False,
                    "data": mcp_result.data,
                    "error": mcp_result.error,
                    "tool_name": task_name,
                    "execution_time_ms": mcp_result.execution_time_ms,
                    "timestamp": mcp_result.timestamp.isoformat() if hasattr(mcp_result.timestamp, 'isoformat') else str(mcp_result.timestamp),
                    "fallback_used": mcp_result.fallback_used,
                    "error_type": mcp_result.error_type
                }
                logger.warning(f"⚠️ MCP结果包含错误: {task_name}, 错误: {mcp_result.error}")
                return parsed_result
        
        # 如果是字典格式
        elif isinstance(mcp_result, dict):
            # 确保包含必需字段
            parsed_result = {
                "success": mcp_result.get("success", True),
                "data": mcp_result.get("data", mcp_result),
                "tool_name": task_name,
                "timestamp": mcp_result.get("timestamp", time.time())
            }
            logger.debug(f"✅ MCP结果解析成功（字典格式）: {task_name}")
            return parsed_result
        
        # 其他类型，包装成字典
        else:
            parsed_result = {
                "success": True,
                "data": mcp_result,
                "tool_name": task_name,
                "timestamp": time.time()
            }
            logger.debug(f"✅ MCP结果解析成功（其他格式）: {task_name}")
            return parsed_result
    
    except Exception as e:
        logger.error(f"❌ MCP结果解析失败: {task_name}, 错误: {e}", exc_info=True)
        return {
            "success": False,
            "data": None,
            "error": f"结果解析失败: {str(e)}",
            "tool_name": task_name,
            "timestamp": time.time()
        }


def _extract_and_validate_mcp_parameters(
    task_name: str,
    task_info: dict,
    user_profile: dict,
    dag_results: dict
) -> dict:
    """
    从DAG任务中提取并验证MCP工具参数
    
    Args:
        task_name: 任务名称
        task_info: 任务信息
        user_profile: 用户档案
        dag_results: 已完成的DAG任务结果
    
    Returns:
        dict: 验证后的参数字典
    """
    # 获取工具配置
    tool_config = TASK_TO_TOOL_MAPPING.get(task_name)
    if not tool_config:
        logger.error(f"❌ 工具配置不存在: {task_name}")
        return {}
    
    # 从task_info中提取参数
    parameters = task_info.get("params", {}).copy()
    
    # 自动填充必需参数
    required_params = tool_config.get("required_params", [])
    
    for param in required_params:
        if param not in parameters:
            # 尝试从上下文中获取参数
            if param == "user_profile" and user_profile:
                parameters["user_profile"] = user_profile
                logger.debug(f"✅ 自动填充参数: {param} (来源: user_profile)")
            
            elif param == "exercises":
                # 尝试从之前的检索结果中获取exercises
                if "semantic_search" in dag_results:
                    search_results = dag_results["semantic_search"]
                    if isinstance(search_results, dict) and "results" in search_results:
                        exercises = search_results["results"]
                        parameters["exercises"] = exercises
                        logger.debug(f"✅ 自动填充参数: {param} (来源: semantic_search)")
                    else:
                        logger.warning(f"⚠️ 无法从semantic_search获取exercises")
                        parameters["exercises"] = []
                else:
                    logger.warning(f"⚠️ 缺少必需参数: {param}")
                    parameters["exercises"] = []
            
            elif param == "exercise_id":
                # 尝试从参数中获取exercise_id
                if "exercise" in parameters:
                    exercise = parameters["exercise"]
                    if isinstance(exercise, dict) and "id" in exercise:
                        parameters["exercise_id"] = exercise["id"]
                        logger.debug(f"✅ 自动填充参数: {param} (来源: exercise.id)")
                    elif isinstance(exercise, str):
                        parameters["exercise_id"] = exercise
                        logger.debug(f"✅ 自动填充参数: {param} (来源: exercise)")
                else:
                    logger.warning(f"⚠️ 缺少必需参数: {param}")
                    parameters["exercise_id"] = None
            
            else:
                logger.warning(f"⚠️ 缺少必需参数: {param}")
    
    # 验证参数格式
    for param_name, param_value in parameters.items():
        if param_value is None:
            logger.warning(f"⚠️ 参数值为None: {param_name}")
        elif param_name == "user_profile" and not isinstance(param_value, dict):
            logger.warning(f"⚠️ 参数类型错误: {param_name} (期望dict, 实际{type(param_value).__name__})")
        elif param_name == "exercises" and not isinstance(param_value, list):
            logger.warning(f"⚠️ 参数类型错误: {param_name} (期望list, 实际{type(param_value).__name__})")
    
    logger.info(f"✅ 参数提取完成: {task_name}, 参数数量: {len(parameters)}")
    return parameters




async def execute_eleven_step_workflow_stream(
    query_text: str,
    user_id: str,
    domain: str = "fitness",
    user_profile: Optional[Dict[str, Any]] = None,
    session_id: Optional[str] = None
):
    """
    执行11步工作流程（流式版本）
    
    步骤1-9保持同步执行，步骤10改为流式LLM调用
    
    优化：
    - 步骤1-2并行执行（优化TTFB）
    - 步骤3-4并行执行（优化TTFB）
    - 完整的步骤性能监控
    
    Args:
        query_text: 用户查询文本
        user_id: 用户ID
        domain: 领域（默认fitness）
        user_profile: 用户档案（可选）
        session_id: 会话ID（可选）
    
    Yields:
        Dict[str, Any]: SSE事件
            - type: "step" | "chunk" | "structured_data" | "done" | "error"
            - data: 事件数据
    """
    start_time = time.time()
    request_id = str(uuid.uuid4())[:8]
    
    # 导入流式监控器和性能监控器
    from ...framework.monitoring.streaming_metrics import streaming_monitor
    from ...framework.monitoring.step_performance import WorkflowPerformanceMonitor
    from ...framework.monitoring.enhanced_logging import enhanced_logger
    from ...framework.monitoring.performance_monitor import get_performance_monitor
    
    # 初始化性能监控器（流式专用）
    perf_monitor = WorkflowPerformanceMonitor(request_id)
    
    # ✅ 新增：初始化通用性能监控器
    performance_monitor = get_performance_monitor()
    perf_context = performance_monitor.start_workflow(
        request_id=request_id,
        user_id=str(user_id)
    )
    logger.info(f"📊 [请求ID: {request_id}] 性能监控已启动（流式）")
    
    # 增加活跃连接数
    streaming_monitor.increment_active_connections()
    
    # 初始化增强日志记录器并记录会话开始
    log_context = enhanced_logger.log_session_start(
        request_id=request_id,
        user_id=str(user_id),
        session_id=session_id or "new",
        query=query_text,
        domain=domain
    )
    
    # 流式会话监控变量
    ttfb_ms = None  # 首字节响应时间
    first_chunk_time = None
    tokens_generated = 0
    content_length = 0
    structured_data_count = 0
    retry_count = 0
    
    try:
        # 导入所需的组件
        from .clients.backend_client import BackendClient
        from ...framework.models.query_complexity_classifier import QueryComplexityClassifier
        
        backend_client = BackendClient()
        
        # ✅ 初始化并行步骤执行器（流式版本）
        parallel_executor = ParallelStepExecutor(
            request_id=request_id,
            default_timeout=10.0,  # 10秒超时
            enable_fallback=True,
            enable_monitoring=True
        )
        
        # ===== 步骤1-2：并行执行（优化TTFB） =====
        enhanced_logger.log_step_start(request_id, 1, "预加载用户档案")
        enhanced_logger.log_step_start(request_id, 2, "会话记录存储")
        
        step_start_time = time.time()
        logger.info(
            f"[{request_id}] 步骤1-2开始: "
            f"并行执行（用户档案加载 + 会话初始化）, "
            f"timestamp={time.strftime('%Y-%m-%d %H:%M:%S')}"
        )
        
        yield {
            "type": "step",
            "step": 1,
            "message": "正在加载用户档案和初始化会话..."
        }
        
        # 创建步骤性能记录
        step1_perf = perf_monitor.create_step(1, "预加载用户档案")
        step2_perf = perf_monitor.create_step(2, "会话记录存储")
        
        # 定义步骤1：预加载用户档案
        async def load_user_profile():
            step1_perf.start()
            nonlocal user_profile
            
            if not user_profile and user_id:
                try:
                    if isinstance(user_id, int):
                        user_id_int = user_id
                    elif isinstance(user_id, str) and user_id.isdigit():
                        user_id_int = int(user_id)
                    else:
                        user_id_int = None
                    
                    if user_id_int:
                        user_profile = await backend_client.get_user_profile(user_id_int)
                        step1_perf.finish(success=True, profile_loaded=bool(user_profile))
                        enhanced_logger.log_step_complete(
                            request_id, 1, success=True,
                            result_summary=f"用户档案{'已加载' if user_profile else '未找到'}",
                            metadata={"profile_loaded": bool(user_profile)}
                        )
                        logger.info(f"✅ [{request_id}] 步骤1完成: 用户档案已加载")
                    else:
                        step1_perf.skip("无效的user_id")
                        enhanced_logger.log_step_complete(
                            request_id, 1, success=True,
                            result_summary="跳过用户档案加载（无效user_id）"
                        )
                        logger.info(f"✅ [{request_id}] 步骤1完成: 跳过用户档案加载")
                except Exception as e:
                    step1_perf.finish(success=False, error=str(e))
                    enhanced_logger.log_error(request_id, e, step_number=1)
                    enhanced_logger.log_step_complete(
                        request_id, 1, success=False,
                        result_summary=f"用户档案加载失败: {str(e)}"
                    )
                    logger.warning(f"⚠️ [{request_id}] 步骤1: 用户档案加载失败: {e}")
            else:
                step1_perf.skip("已提供用户档案")
                enhanced_logger.log_step_complete(
                    request_id, 1, success=True,
                    result_summary="使用已提供的用户档案"
                )
            
            return user_profile
        
        # 定义步骤2：会话记录存储
        async def create_session():
            step2_perf.start()
            nonlocal session_id
            
            if not session_id:
                session_id = f"session_{user_id or 'anonymous'}_{int(time.time())}"
            
            step2_perf.finish(success=True, session_id=session_id[:16])
            enhanced_logger.log_step_complete(
                request_id, 2, success=True,
                result_summary=f"会话ID={session_id[:16]}...",
                metadata={"session_id": session_id}
            )
            logger.info(f"✅ [{request_id}] 步骤2完成: 会话ID={session_id[:16]}...")
            return session_id
        
        # 并行执行步骤1和步骤2
        parallel_start = time.time()
        user_profile, session_id = await asyncio.gather(
            load_user_profile(),
            create_session()
        )
        parallel_duration = (time.time() - parallel_start) * 1000
        logger.info(f"✅ [{request_id}] 步骤1-2并行完成，总耗时: {parallel_duration:.2f}ms")
        
        # ✅ 新增：记录步骤1-2的性能（流式）
        performance_monitor.record_step(
            context=perf_context,
            step_number=1,
            step_name="预加载用户档案",
            duration_ms=parallel_duration / 2,
            success=user_profile is not None,
            metadata={"profile_loaded": bool(user_profile), "stream": True}
        )
        performance_monitor.record_step(
            context=perf_context,
            step_number=2,
            step_name="会话记录存储",
            duration_ms=parallel_duration / 2,
            success=True,
            metadata={"session_id": session_id[:16] if session_id else None, "stream": True}
        )
        
        # ===== 步骤3-4：并行执行（优化TTFB） =====
        logger.info(f"[{request_id}] 步骤3-4: 并行执行（会员权限检查 + BGE复杂度分类）")
        
        yield {
            "type": "step",
            "step": 3,
            "message": "检查会员权限和分析查询复杂度..."
        }
        
        # 创建步骤性能记录
        step3_perf = perf_monitor.create_step(3, "检查会员权限")
        step4_perf = perf_monitor.create_step(4, "BGE复杂度分类")
        
        # 定义步骤3：检查会员权限
        async def check_membership():
            """步骤3：检查会员权限（带完整错误处理）"""
            step3_perf.start()
            membership = None
            
            if user_id:
                try:
                    if isinstance(user_id, int):
                        user_id_int = user_id
                    elif isinstance(user_id, str) and user_id.isdigit():
                        user_id_int = int(user_id)
                    else:
                        user_id_int = None
                    
                    if user_id_int:
                        # 使用智能缓存获取会员权限（带超时控制和降级策略）
                        membership_cache = get_membership_cache(backend_client=backend_client)
                        membership = await membership_cache.get_user_membership(str(user_id_int))
                        
                        if membership:
                            tier = membership.get('tier', 'free')
                            is_fallback = membership.get('_fallback', False)
                            step3_perf.finish(success=True, tier=tier, is_fallback=is_fallback)
                            if is_fallback:
                                logger.info(f"✅ [{request_id}] 步骤3完成: 会员等级={tier}（降级）")
                            else:
                                logger.info(f"✅ [{request_id}] 步骤3完成: 会员等级={tier}")
                        else:
                            step3_perf.finish(success=False, error="会员信息未找到")
                            logger.info(f"✅ [{request_id}] 步骤3完成: 会员信息未找到")
                    else:
                        step3_perf.skip("无效的user_id")
                        logger.info(f"✅ [{request_id}] 步骤3完成: 匿名用户")
                except Exception as e:
                    step3_perf.finish(success=False, error=str(e))
                    logger.warning(f"⚠️ [{request_id}] 步骤3: 会员权限检查失败: {e}")
                    # 不抛出异常，允许工作流继续
            else:
                step3_perf.skip("无user_id")
            
            return membership
        
        # 定义步骤4：BGE复杂度分类
        async def classify_complexity():
            """步骤4：BGE复杂度分类（带完整错误处理）"""
            step4_perf.start()
            
            try:
                classifier = QueryComplexityClassifier()
                result = classifier.classify_complexity(query_text)
                
                # 提取结果
                is_complex = result.is_complex
                similarity = result.similarity
                reason = result.reason
                
                step4_perf.finish(
                    success=True,
                    is_complex=is_complex,
                    similarity=similarity,
                    reason=reason,
                    cache_hit=result.cache_hit,
                    duration_ms=result.duration_ms,
                    fallback_used=result.fallback_used
                )
                logger.info(
                    f"✅ [{request_id}] 步骤4完成: 复杂度={'复杂' if is_complex else '简单'}, "
                    f"耗时={result.duration_ms:.2f}ms, 缓存命中={result.cache_hit}"
                )
                
                return is_complex, similarity, reason
                
            except Exception as e:
                logger.warning(f"⚠️ [{request_id}] 步骤4: BGE复杂度分类失败: {e}")
                # 降级策略：默认为简单查询
                step4_perf.finish(success=False, error=str(e), fallback_used=True)
                logger.info(f"✅ [{request_id}] 步骤4完成: 使用降级策略（默认简单查询）")
                return False, 0.0, "降级策略"
        
        # 使用并行执行器执行步骤3和步骤4
        parallel_result = await parallel_executor.execute_parallel_steps(
            steps=[
                (3, "检查会员权限", check_membership),
                (4, "BGE复杂度分类", classify_complexity)
            ],
            timeout=10.0,  # 10秒超时
            continue_on_error=True  # 即使某个步骤失败也继续
        )
        
        # 提取步骤结果
        membership = parallel_executor.extract_step_data(parallel_result, 3, default=None)
        complexity_result = parallel_executor.extract_step_data(parallel_result, 4, default=(False, 0.0, "降级策略"))
        is_complex, similarity, reason = complexity_result
        
        # 记录并行执行摘要
        logger.info(
            f"✅ [{request_id}] 步骤3-4并行完成: "
            f"总耗时={parallel_result.total_duration_ms:.0f}ms, "
            f"成功={parallel_result.metadata['successful_steps']}/{parallel_result.metadata['total_steps']}, "
            f"失败={parallel_result.metadata['failed_steps']}"
        )
        
        # 记录失败的步骤（如果有）
        if parallel_result.failed_steps:
            for failed_step in parallel_result.failed_steps:
                logger.warning(
                    f"⚠️ [{request_id}] 步骤{failed_step.step_number} {failed_step.step_name} 失败: "
                    f"{failed_step.error}"
                )
        
        # ✅ 新增：记录步骤3-4的性能（流式）
        performance_monitor.record_step(
            context=perf_context,
            step_number=3,
            step_name="检查会员权限",
            duration_ms=parallel_result.total_duration_ms / 2,
            success=membership is not None,
            metadata={
                "tier": membership.get('tier', 'unknown') if membership else None,
                "is_fallback": membership.get('_fallback', False) if membership else False,
                "stream": True,
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )
        performance_monitor.record_step(
            context=perf_context,
            step_number=4,
            step_name="BGE复杂度分类",
            duration_ms=parallel_result.total_duration_ms / 2,
            success=True,
            metadata={
                "is_complex": is_complex,
                "similarity": similarity,
                "reason": reason,
                "stream": True,
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )
        
        # ===== 步骤5：智能模型选择 =====
        step5_perf = perf_monitor.create_step(5, "智能模型选择")
        step5_perf.start()
        
        yield {
            "type": "step",
            "step": 5,
            "message": "选择AI模型..."
        }
        
        model_choice = "teacher" if is_complex or similarity >= 0.7 else "student"
        step5_perf.finish(success=True, model=model_choice)
        logger.info(f"✅ [{request_id}] 步骤5完成: 选择模型={model_choice}")
        
        # ===== 步骤6：Few-Shot检索 =====
        step6_perf = perf_monitor.create_step(6, "Few-Shot检索")
        step6_perf.start()
        
        yield {
            "type": "step",
            "step": 6,
            "message": "检索最佳实践..."
        }
        
        few_shot_examples = []
        try:
            from ...framework.retrieval.enhanced_few_shot_retriever import EnhancedFewShotRetriever
            
            few_shot_retriever = EnhancedFewShotRetriever(
                vector_store=None,
                backend_client=backend_client
            )
            
            best_practices = await few_shot_retriever.get_best_practices(
                query=query_text,
                user_profile=user_profile,
                domain=domain,
                top_k=3
            )
            
            for match in best_practices:
                bp = match.best_practice
                formatted = few_shot_retriever.best_practices_retriever.format_best_practice(
                    bp, user_profile,
                    {"exercise_name": "动作", "goal": user_profile.get("fitness_goal", "健康") if user_profile else "健康"}
                )
                
                few_shot_examples.append({
                    "query": bp.query_pattern,
                    "response": formatted,
                    "match_score": match.match_score,
                    "pattern_id": bp.pattern_id
                })
            
            step6_perf.finish(success=True, examples_count=len(few_shot_examples))
            logger.info(f"✅ [{request_id}] 步骤6完成: {len(few_shot_examples)}个最佳实践")
        except Exception as e:
            step6_perf.finish(success=False, error=str(e))
            logger.warning(f"⚠️ [{request_id}] 步骤6: Few-Shot检索异常: {e}")
        
        # ===== 步骤6.5：LLM选择DAG模板 =====
        step6_5_perf = perf_monitor.create_step(7, "LLM选择DAG模板")  # 使用7作为编号
        step6_5_perf.start()
        
        yield {
            "type": "step",
            "step": 6,
            "message": "选择执行方案..."
        }
        
        selected_template_id = None
        try:
            from .llm_decision_engine import LLMDecisionEngine, DAGSelectionRequest
            from .dag_template_system import DAGTemplateManager
            
            template_manager = DAGTemplateManager()
            decision_engine = LLMDecisionEngine(template_manager)
            
            selection_request = DAGSelectionRequest(
                user_query=query_text,
                user_profile=user_profile or {},
                available_templates=template_manager.get_all_templates(),
                session_context={"session_id": session_id},
                few_shot_examples=few_shot_examples
            )
            
            selection_result = await decision_engine.select_dag_template(selection_request)
            selected_template_id = selection_result.selected_template_id
            
            step6_5_perf.finish(
                success=True,
                template_id=selected_template_id,
                confidence=selection_result.confidence
            )
            logger.info(f"✅ [{request_id}] 步骤6.5完成: 选择模板={selected_template_id}")
        except Exception as e:
            step6_5_perf.finish(success=False, error=str(e))
            logger.warning(f"⚠️ [{request_id}] 步骤6.5: LLM选择失败: {e}")
            from .dag_template_system import DAGTemplateManager
            template_manager = DAGTemplateManager()
            selected_template_id = template_manager.match_template_by_keywords(query_text)
            logger.info(f"✅ [{request_id}] 步骤6.5完成: 使用降级策略，选择模板={selected_template_id}")
        
        # ===== 步骤7-8：DAG编排执行 =====
        step7_8_perf = perf_monitor.create_step(8, "DAG编排执行")
        step7_8_perf.start()
        
        yield {
            "type": "step",
            "step": 7,
            "message": "执行数据分析..."
        }
        
        dag_results = {}
        result = {}
        try:
            from .enhanced_dag_orchestrator import EnhancedDAGOrchestrator
            from .dag_template_system import DAGTemplateManager
            from ...framework.clients.mcp_tool_manager import MCPToolManager
            from ...framework.clients.mcp_client_v2 import create_configurable_mcp_client
            from .mcp_tools.registry import MCPToolRegistry
            from .mcp_tools import initialize_all_tools
            from ...framework.clients.neo4j_client import Neo4jClient
            from ...framework.clients.qdrant_client import QdrantClient
            from ...framework.retrieval.true_three_layer_engine import TrueThreeLayerEngine
            
            # 初始化MCP客户端
            mcp_client = create_configurable_mcp_client()
            try:
                await mcp_client.connect()
                logger.info(f"✅ [{request_id}] MCP客户端连接成功")
            except Exception as e:
                logger.warning(f"⚠️ [{request_id}] MCP客户端连接失败: {e}")
                mcp_client = None
            
            # 初始化数据库客户端和检索引擎
            neo4j_client = Neo4jClient()
            qdrant_client = QdrantClient()
            three_layer_engine = TrueThreeLayerEngine()
            
            # 初始化Python工具注册表
            python_tool_registry = MCPToolRegistry()
            initialize_all_tools(
                python_tool_registry,
                neo4j_client=neo4j_client,
                qdrant_client=qdrant_client,
                three_layer_engine=three_layer_engine,
                backend_client=backend_client,  # ✅ v1.1.0新增：用于find_similar_training_cases
                vector_store=qdrant_client  # ✅ v1.1.0新增：用于find_similar_training_cases
            )
            
            # 初始化MCP工具管理器
            mcp_tool_manager = MCPToolManager(
                mcp_client=mcp_client,
                python_tool_registry=python_tool_registry
            )
            
            # 初始化DAG编排器
            template_manager = DAGTemplateManager()
            dag_orchestrator = EnhancedDAGOrchestrator(
                template_manager=template_manager,
                mcp_orchestrator=mcp_tool_manager
            )
            
            # 执行DAG模板
            dag_execution_result = await dag_orchestrator.execute_template(
                template_id=selected_template_id,
                user_profile=user_profile or {},
                session_context={"session_id": session_id, "query": query_text},
                cached_results=None
            )
            
            dag_results = dag_execution_result.results
            
            if dag_results:
                result = {
                    "results": _convert_dag_results_to_graphrag_format(dag_results),
                    "query_type": "dag_orchestration",
                    "domain": domain,
                    "count": len(dag_results),
                    "dag_tasks": list(dag_results.keys()),
                    "template_id": selected_template_id,
                    "tasks_completed": dag_execution_result.tasks_completed,
                    "tasks_failed": dag_execution_result.tasks_failed
                }
                step7_8_perf.finish(
                    success=True,
                    tasks_completed=dag_execution_result.tasks_completed,
                    tasks_failed=dag_execution_result.tasks_failed
                )
                logger.info(f"✅ [{request_id}] 步骤7-8完成: {dag_execution_result.tasks_completed}个任务成功")
            else:
                step7_8_perf.finish(success=False, error="DAG任务执行失败")
                logger.warning(f"⚠️ [{request_id}] 步骤7-8: DAG任务执行失败")
                result = {"results": [], "query_type": "dag_orchestration", "domain": domain, "count": 0}
        except Exception as e:
            step7_8_perf.finish(success=False, error=str(e))
            logger.warning(f"⚠️ [{request_id}] 步骤7-8: DAG任务执行异常: {e}")
            result = {"results": [], "query_type": "dag_orchestration", "domain": domain, "count": 0, "error": str(e)}
        
        # ===== 步骤9：工具结果汇总 =====
        step9_perf = perf_monitor.create_step(9, "工具结果汇总")
        step9_perf.start()
        
        yield {
            "type": "step",
            "step": 9,
            "message": "数据检索完成，开始生成回答"
        }
        
        all_data = {}
        mcp_tools_called = []
        
        if dag_results:
            for task_name, task_result in dag_results.items():
                if task_name in MCP_TASK_TYPES:
                    if task_result and isinstance(task_result, dict):
                        all_data[task_name] = task_result
                        has_error = "error" in task_result and task_result["error"] is not None
                        is_success = task_result.get("success", False) is True
                        is_fallback = task_result.get("fallback", False) or task_result.get("fallback_used", False)
                        
                        if is_success and not has_error and not is_fallback:
                            mcp_tools_called.append(task_name)
        
        if user_profile:
            all_data["user_profile"] = user_profile
        if membership:
            all_data["user_membership"] = membership
        if result and result.get("results"):
            all_data["retrieval_results"] = {
                "results": result.get("results", []),
                "count": result.get("count", 0),
                "query_type": result.get("query_type", "unknown")
            }
        
        step9_perf.finish(
            success=True,
            mcp_tools_count=len(mcp_tools_called),
            data_items=len(all_data)
        )
        logger.info(f"✅ [{request_id}] 步骤9完成: {len(mcp_tools_called)}个MCP工具, {len(all_data)}项数据")
        
        # ===== 步骤10：LLM流式生成回答 =====
        logger.info(
            f"📝 [{request_id}] 步骤10: LLM流式生成回答 "
            f"(模板={selected_template_id})"
        )
        
        try:
            from ...framework.config.llm_response_config_manager import LLMResponseConfigManager
            from .dag_template_system import DAGTemplateManager
            from ...framework.clients.llm_client import call_deepseek_stream, LLMConfig
            
            # 初始化配置管理器
            config_manager = LLMResponseConfigManager()
            llm_response_config = config_manager.get_config(selected_template_id)
            
            # 获取response_hint
            template_manager = DAGTemplateManager()
            selected_template = template_manager.get_template(selected_template_id)
            response_hint = selected_template.response_hint if selected_template else "请提供专业的分析和建议"
            
            # 准备用户档案（移除不可序列化的对象）
            user_profile_str = '未提供'
            if user_profile:
                try:
                    # 创建一个可序列化的副本
                    serializable_profile = {}
                    for key, value in user_profile.items():
                        # 跳过不可序列化的对象（如MembershipPermissions）
                        if key == 'membership' and hasattr(value, '__dict__'):
                            # 如果是对象，尝试提取基本属性
                            if hasattr(value, 'tier'):
                                serializable_profile['membership_tier'] = str(value.tier)
                            if hasattr(value, 'permissions'):
                                serializable_profile['membership_permissions'] = str(value.permissions)
                        elif isinstance(value, (str, int, float, bool, list, dict, type(None))):
                            serializable_profile[key] = value
                        else:
                            # 其他对象转换为字符串
                            serializable_profile[key] = str(value)
                    
                    user_profile_str = json.dumps(serializable_profile, ensure_ascii=False, indent=2)
                except Exception as e:
                    logger.warning(f"用户档案序列化失败: {e}，使用字符串表示")
                    user_profile_str = str(user_profile)
            
            # 准备MCP工具结果（移除不可序列化的对象）
            mcp_tools_result_str = "{}"
            if all_data:
                try:
                    # 递归清理不可序列化的对象
                    def make_serializable(obj):
                        if isinstance(obj, dict):
                            return {k: make_serializable(v) for k, v in obj.items()}
                        elif isinstance(obj, list):
                            return [make_serializable(item) for item in obj]
                        elif isinstance(obj, (str, int, float, bool, type(None))):
                            return obj
                        else:
                            # 其他对象转换为字符串
                            return str(obj)
                    
                    serializable_data = make_serializable(all_data)
                    
                    # ✅ 新增：集成WeeklyPlanGenerator实现分周输出（流式版本）
                    # Requirements: 10.1 - 只输出第1周完整计划
                    if "professional_program_designer" in serializable_data:
                        program_result = serializable_data["professional_program_designer"]
                        if program_result and not program_result.get("error"):
                            try:
                                from .services.weekly_plan_generator import WeeklyPlanGenerator
                                
                                weekly_generator = WeeklyPlanGenerator()
                                
                                # 获取总周数（默认4周）
                                total_weeks = program_result.get("program_overview", {}).get("training_weeks", 4)
                                
                                # 生成第1周计划
                                weekly_plan = weekly_generator.generate_first_week(
                                    full_program=program_result,
                                    user_profile=user_profile,
                                    total_weeks=total_weeks
                                )
                                
                                # 转换为输出格式
                                weekly_plan_output = weekly_generator.convert_to_output_format(weekly_plan)
                                
                                # 将分周计划添加到结果中
                                serializable_data["professional_program_designer"]["weekly_plan_output"] = weekly_plan_output
                                serializable_data["professional_program_designer"]["output_mode"] = "weekly"
                                
                                logger.info(
                                    f"   [{request_id}] 分周输出: 第{weekly_plan_output['week_number']}周/"
                                    f"{weekly_plan_output['total_weeks']}周, "
                                    f"阶段={weekly_plan_output['phase']}"
                                )
                                
                            except Exception as weekly_gen_error:
                                logger.warning(f"分周计划生成失败，使用完整输出: {weekly_gen_error}")
                                serializable_data["professional_program_designer"]["output_mode"] = "full"
                    
                    mcp_tools_result_str = json.dumps(serializable_data, ensure_ascii=False, indent=2)
                except Exception as e:
                    logger.warning(f"MCP工具结果序列化失败: {e}，使用字符串表示")
                    mcp_tools_result_str = str(all_data)
            
            # 构建消息列表
            messages = config_manager.build_messages(
                template_id=selected_template_id,
                query=query_text,
                user_profile=user_profile_str,
                response_hint=response_hint,
                mcp_tools_result=mcp_tools_result_str,
                retrieval_results=result.get('results', [])
            )
            
            logger.info(
                f"   [{request_id}] LLM配置: "
                f"max_tokens={llm_response_config.max_tokens}, "
                f"temperature={llm_response_config.temperature}"
            )
            
            # 流式调用LLM（使用降级管理器）
            full_response = ""
            chunk_count = 0
            structured_data_extracted = False  # 标记是否已提取结构化数据
            backend_used = None
            fallback_used = False
            attempt_count = 0
            llm_error = None
            
            try:
                from ...framework.clients.llm_fallback_manager import LLMFallbackManager, LLMRequest
                
                # 初始化降级管理器
                fallback_manager = LLMFallbackManager(
                    primary_backend="deepseek",
                    fallback_backends=["ollama", "template"],
                    max_retries=3,
                    timeout=180,  # 流式调用超时时间更长
                    enable_health_check=True
                )
                
                # 准备LLM请求
                llm_request = LLMRequest(
                    query=query_text,
                    few_shot_examples=[],
                    tool_results=all_data,
                    system_prompt="",
                    max_tokens=llm_response_config.max_tokens,
                    temperature=llm_response_config.temperature,
                    stream=True,
                    messages=messages
                )
                
                # 使用降级管理器进行流式调用
                async for chunk, metadata in fallback_manager.call_with_fallback_stream(llm_request):
                    # 如果是元数据（流式结束）
                    if metadata:
                        backend_used = metadata.backend_used.value
                        fallback_used = metadata.fallback_used
                        attempt_count = metadata.attempt_count
                        llm_error = metadata.error
                        
                        # 记录降级信息
                        if fallback_used:
                            logger.warning(
                                f"⚠️ [{request_id}] 步骤10: 使用了降级策略 "
                                f"(backend={backend_used}, attempts={attempt_count})"
                            )
                        
                        if llm_error:
                            logger.warning(
                                f"⚠️ [{request_id}] 步骤10: LLM调用有错误 "
                                f"(error={llm_error})"
                            )
                        
                        if metadata.partial_success:
                            logger.warning(
                                f"⚠️ [{request_id}] 步骤10: 部分成功 "
                                f"(已生成{len(full_response)}字)"
                            )
                        
                        continue
                    
                    # 如果是空字符串，跳过
                    if not chunk:
                        continue
                    
                    # 记录首字节响应时间
                    if first_chunk_time is None:
                        first_chunk_time = time.time()
                        ttfb_ms = (first_chunk_time - start_time) * 1000
                        logger.info(
                            f"⚡ [{request_id}] 首字节响应: "
                            f"TTFB={ttfb_ms:.0f}ms"
                        )
                    
                    full_response += chunk
                    chunk_count += 1
                    tokens_generated += len(chunk.split())  # 粗略估算token数
                    
                    # 每100个chunk记录一次进度
                    if chunk_count % 100 == 0:
                        logger.debug(
                            f"📝 [{request_id}] 生成进度: "
                            f"{len(full_response)}字, "
                            f"{tokens_generated} tokens (估算)"
                        )
                    
                    # 检测结构化数据标记（支持多种类型）
                    if not structured_data_extracted:
                        # 定义支持的结构化数据类型及其标记
                        structured_data_markers = {
                            "TRAINING_PLAN": "training_plan",
                            "NUTRITION_DATA": "nutrition_data",
                            "PROGRESS_CHART": "progress_chart"
                        }
                        
                        # 遍历所有支持的标记类型
                        for marker, data_type in structured_data_markers.items():
                            marker_tag = f"[{marker}:"
                            
                            if marker_tag in full_response:
                                # 尝试提取JSON数据
                                try:
                                    start_idx = full_response.find(marker_tag)
                                    if start_idx != -1:
                                        # 查找结束标记（可能需要等待更多chunk）
                                        # 使用更智能的方式：查找JSON对象的结束
                                        json_start = start_idx + len(marker_tag)
                                        
                                        # 尝试找到完整的JSON对象
                                        # 简单方法：查找 }] 组合（JSON对象结束 + 标记结束）
                                        potential_end = full_response.find("}]", json_start)
                                        
                                        if potential_end != -1:
                                            # 找到了完整的JSON
                                            json_str = full_response[json_start:potential_end + 1]  # 包含最后的 }
                                            
                                            try:
                                                structured_data = json.loads(json_str)
                                                structured_data_count += 1
                                                structured_data_extracted = True  # 标记已提取
                                                
                                                # 记录结构化数据检测
                                                enhanced_logger.log_structured_data_detected(
                                                    request_id=request_id,
                                                    data_type=data_type,
                                                    data_size=len(json_str),
                                                    marker=marker,
                                                    extraction_success=True
                                                )
                                                
                                                yield {
                                                    "type": "structured_data",
                                                    "data_type": data_type,
                                                    "data": structured_data
                                                }
                                                
                                                logger.info(
                                                    f"📦 [{request_id}] 检测到结构化数据: "
                                                    f"type={data_type}, "
                                                    f"marker={marker}, "
                                                    f"size={len(json_str)}字节"
                                                )
                                                
                                                # 找到一个就跳出循环
                                                break
                                                
                                            except json.JSONDecodeError as json_err:
                                                # JSON解析失败，可能还没接收完整
                                                logger.debug(
                                                    f"   [{request_id}] JSON尚未完整，继续等待... "
                                                    f"marker={marker}, "
                                                    f"(已接收{len(json_str)}字节)"
                                                )
                                except Exception as e:
                                    enhanced_logger.log_error(
                                        request_id, e,
                                        context_info={"marker": marker, "data_type": data_type}
                                    )
                                    logger.warning(
                                        f"⚠️ [{request_id}] 提取结构化数据失败: "
                                        f"marker={marker}, error={e}"
                                    )
                    
                    # 发送文本片段
                    yield {
                        "type": "chunk",
                        "content": chunk
                    }
                
                content_length = len(full_response)
                total_duration_ms = (time.time() - start_time) * 1000
                tokens_per_second = tokens_generated / (total_duration_ms / 1000) if total_duration_ms > 0 else 0
                
                # 记录会话完成
                enhanced_logger.log_session_complete(
                    request_id=request_id,
                    tokens_generated=tokens_generated,
                    content_length=content_length,
                    ttfb_ms=ttfb_ms,
                    generation_speed=tokens_per_second
                )
                
                logger.info(
                    f"✅ [{request_id}] 步骤10完成: "
                    f"backend={backend_used or 'unknown'}, "
                    f"fallback={fallback_used}, "
                    f"attempts={attempt_count}, "
                    f"总长度={content_length}字, "
                    f"总耗时={total_duration_ms:.0f}ms, "
                    f"速度={tokens_per_second:.1f} tokens/s"
                )
                
            except Exception as e:
                error_type = type(e).__name__
                logger.error(
                    f"❌ [{request_id}] 步骤10: LLM流式生成失败: "
                    f"error_type={error_type}, error={str(e)}",
                    exc_info=True
                )
                
                # 如果有部分内容，标记为部分成功
                if full_response:
                    logger.info(
                        f"⚠️ [{request_id}] 步骤10: 部分成功，已生成{len(full_response)}字"
                    )
                
                # 重新抛出异常，让外层处理
                raise
            
            # ===== 步骤11：记录交互（用于未来学习） =====
            step11_start = time.time()
            try:
                # 转换user_id为整数
                user_id_int = int(user_id) if isinstance(user_id, str) and user_id.isdigit() else None
                
                if user_id_int:
                    # 导入后端客户端
                    from .clients.backend_client import BackendClient
                    backend_client = BackendClient()
                    
                    # 保存会话记录
                    result_data = await backend_client.save_chat_session(
                        session_id=session_id,
                        user_id=user_id_int,
                        user_query=query_text,
                        llm_response=full_response,
                        model_used="deepseek-chat",  # 流式模式使用的模型
                        tools_used=[],  # 流式模式暂不记录工具
                        metadata={
                            "graphrag_service": True,
                            "streaming_mode": True,
                            "tokens_generated": tokens_generated,
                            "content_length": content_length,
                            "ttfb_ms": ttfb_ms,
                            "request_id": request_id
                        },
                        qdrant_point_id=None
                    )
                    logger.info(f"✅ [{request_id}] 步骤11完成: 交互记录完成 (db_id={result_data.get('id')})")
                else:
                    logger.info(f"✅ [{request_id}] 步骤11完成: 匿名用户，跳过记录")
                    
            except BackendValidationError as e:
                # ✅ 改进：详细解析422验证错误
                error_details = parse_validation_error(e)
                error_log = format_validation_error_log(request_id, user_id_int if 'user_id_int' in locals() else user_id, error_details)
                logger.warning(error_log)
                
                if error_details["is_user_not_found"]:
                    logger.info(f"✅ [{request_id}] 步骤11完成: 用户不存在，跳过会话保存（工作流继续）")
                else:
                    logger.info(f"✅ [{request_id}] 步骤11完成: 验证失败，跳过会话保存（工作流继续）")
                    
            except BackendNotFoundError as e:
                logger.warning(f"⚠️ [{request_id}] 步骤11会话保存失败: 资源未找到 - {e}")
                logger.info(f"✅ [{request_id}] 步骤11完成: 资源未找到，跳过会话保存（工作流继续）")
                
            except BackendServerError as e:
                logger.error(f"❌ [{request_id}] 步骤11会话保存失败: 后端服务器错误 - {e}")
                logger.info(f"✅ [{request_id}] 步骤11完成: 服务器错误，跳过会话保存（工作流继续）")
                
            except BackendAPIError as e:
                logger.warning(f"⚠️ [{request_id}] 步骤11会话保存失败: API错误 - {e}")
                logger.info(f"✅ [{request_id}] 步骤11完成: API错误，跳过会话保存（工作流继续）")
                
            except Exception as e:
                logger.warning(f"⚠️ [{request_id}] 步骤11: 交互记录失败: {type(e).__name__}: {e}")
                logger.info(f"✅ [{request_id}] 步骤11完成: 跳过记录，继续工作流程")
            
            # ===== 完成工作流并生成性能报告 =====
            perf_monitor.finish_workflow()
            
            # ✅ 新增：完成通用性能监控
            total_duration_ms = (time.time() - start_time) * 1000
            performance_monitor.finish_workflow(
                context=perf_context,
                success=True,
                total_duration_ms=total_duration_ms
            )
            
            # ✅ 新增：生成性能摘要
            perf_summary_general = performance_monitor.get_workflow_summary(request_id)
            if perf_summary_general:
                logger.info(f"📊 [{request_id}] 通用性能摘要:")
                logger.info(f"   - 总耗时: {perf_summary_general['total_duration_ms']:.0f}ms")
                logger.info(f"   - 总步骤: {perf_summary_general['total_steps']}")
                logger.info(f"   - 性能瓶颈: {perf_summary_general['bottleneck_count']}个")
                
                # 输出性能瓶颈详情
                if perf_summary_general['bottlenecks']:
                    logger.warning(f"⚠️ [{request_id}] 性能瓶颈详情（流式）:")
                    for bottleneck in perf_summary_general['bottlenecks']:
                        logger.warning(
                            f"   - 步骤{bottleneck['step_number']} {bottleneck['step_name']}: "
                            f"{bottleneck['duration_ms']:.0f}ms"
                        )
            
            # 识别性能瓶颈
            bottlenecks = perf_monitor.identify_bottlenecks(threshold_ms=1000.0)
            
            # 获取性能摘要
            perf_summary = perf_monitor.get_summary()
            
            # 发送指标到Prometheus
            perf_monitor.send_metrics_to_prometheus()
            
            # 记录性能摘要到日志
            logger.info(
                f"📊 [{request_id}] 性能摘要: "
                f"总耗时={perf_summary['total_duration_ms']:.2f}ms, "
                f"完成步骤={perf_summary['completed_steps']}/{perf_summary['total_steps']}, "
                f"平均步骤耗时={perf_summary['avg_step_time_ms']:.2f}ms"
            )
            
            if perf_summary['slowest_step']:
                logger.info(
                    f"   最慢步骤: 步骤{perf_summary['slowest_step']['number']} "
                    f"{perf_summary['slowest_step']['name']} "
                    f"({perf_summary['slowest_step']['duration_ms']:.2f}ms)"
                )
            
            # 记录流式监控指标
            if ttfb_ms is not None:
                streaming_monitor.record_streaming_session(
                    user_id=str(user_id),
                    session_id=session_id or "",
                    request_id=request_id,
                    ttfb_ms=ttfb_ms,
                    total_duration_ms=total_duration_ms,
                    tokens_generated=tokens_generated,
                    content_length=content_length,
                    structured_data_count=structured_data_count,
                    success=True,
                    error_type=None,
                    retry_count=retry_count
                )
            
            # 减少活跃连接数
            streaming_monitor.decrement_active_connections()
            
            # 发送完成事件（包含性能摘要）
            yield {
                "type": "done",
                "data": {
                    "request_id": request_id,
                    "total_length": content_length,
                    "duration_ms": int(total_duration_ms),
                    "tokens_generated": tokens_generated,
                    "tokens_per_second": round(tokens_per_second, 2),
                    "ttfb_ms": round(ttfb_ms, 2) if ttfb_ms else None,
                    "structured_data_count": structured_data_count,
                    "mcp_tools_called": len(mcp_tools_called),
                    "template_id": selected_template_id,
                    "performance_summary": {
                        "total_steps": perf_summary['total_steps'],
                        "completed_steps": perf_summary['completed_steps'],
                        "avg_step_time_ms": round(perf_summary['avg_step_time_ms'], 2),
                        "bottlenecks_count": len(bottlenecks)
                    }
                }
            }
            
            logger.info(
                f"🎉 [{request_id}] 流式会话完成: "
                f"成功=True, "
                f"总耗时={total_duration_ms:.0f}ms"
            )
            
        except Exception as e:
            error_type = type(e).__name__
            
            # 记录错误到增强日志
            enhanced_logger.log_error(
                request_id, e,
                context_info={
                    "step": "LLM流式生成",
                    "template_id": selected_template_id,
                    "tokens_generated": tokens_generated,
                    "content_length": content_length
                },
                step_number=10
            )
            
            logger.error(
                f"❌ [{request_id}] 步骤10: LLM流式生成失败: "
                f"error_type={error_type}, "
                f"error={str(e)}",
                exc_info=True
            )
            
            # 记录失败的流式监控指标
            streaming_monitor.record_streaming_session(
                user_id=str(user_id),
                session_id=session_id or "",
                request_id=request_id,
                ttfb_ms=ttfb_ms or 0,
                total_duration_ms=(time.time() - start_time) * 1000,
                tokens_generated=tokens_generated,
                content_length=content_length,
                structured_data_count=structured_data_count,
                success=False,
                error_type=error_type,
                retry_count=retry_count
            )
            
            # 减少活跃连接数
            streaming_monitor.decrement_active_connections()
            
            yield {
                "type": "error",
                "error": f"LLM生成失败: {str(e)}"
            }
    
    except Exception as e:
        error_type = type(e).__name__
        
        # 记录错误到增强日志
        enhanced_logger.log_error(
            request_id, e,
            context_info={
                "step": "工作流程执行",
                "user_id": user_id,
                "query": query_text[:100]
            }
        )
        
        logger.error(
            f"❌ [{request_id}] 工作流程执行失败: "
            f"error_type={error_type}, "
            f"error={str(e)}",
            exc_info=True
        )
        
        # ✅ 新增：记录失败的通用性能监控
        processing_time = time.time() - start_time
        performance_monitor.finish_workflow(
            context=perf_context,
            success=False,
            total_duration_ms=processing_time * 1000
        )
        
        # 记录失败的流式监控指标
        streaming_monitor.record_streaming_session(
            user_id=str(user_id),
            session_id=session_id or "",
            request_id=request_id,
            ttfb_ms=ttfb_ms or 0,
            total_duration_ms=(time.time() - start_time) * 1000,
            tokens_generated=tokens_generated,
            content_length=content_length,
            structured_data_count=structured_data_count,
            success=False,
            error_type=error_type,
            retry_count=retry_count
        )
        
        # 减少活跃连接数
        streaming_monitor.decrement_active_connections()
        
        yield {
            "type": "error",
            "error": f"工作流程执行失败: {str(e)}"
        }



# ============ 统计和监控接口 ============


def get_workflow_statistics() -> Dict[str, Any]:
    """
    获取工作流程统计信息
    
    Returns:
        Dict[str, Any]: 统计信息，包括：
            - cache_stats: 缓存统计
            - workflow_stats: 工作流程统计
            - active_sessions: 活跃会话数
    """
    try:
        workflow_monitor = get_workflow_monitor()
        user_cache = get_user_cache()
        
        return {
            "cache_stats": user_cache.get_statistics() if user_cache else {},
            "workflow_stats": workflow_monitor.get_performance_summary(),
            "active_sessions": workflow_monitor.get_active_sessions(),
            "timestamp": time.time()
        }
    except Exception as e:
        logger.error(f"获取统计信息失败: {e}")
        return {
            "error": str(e),
            "timestamp": time.time()
        }


def visualize_dag_template(template_id: str, format: str = "ascii") -> str:
    """
    可视化DAG模板结构
    
    Args:
        template_id: 模板ID
        format: 可视化格式（ascii, mermaid, graphviz）
    
    Returns:
        str: 可视化内容
    """
    try:
        from .dag_template_system import DAGTemplateManager
        
        template_manager = DAGTemplateManager()
        template = template_manager.get_template(template_id)
        
        if not template:
            return f"❌ 模板不存在: {template_id}"
        
        visualizer = get_dag_visualizer()
        
        # 转换格式枚举
        viz_format = VisualizationFormat.ASCII
        if format.lower() == "mermaid":
            viz_format = VisualizationFormat.MERMAID
        elif format.lower() == "graphviz":
            viz_format = VisualizationFormat.GRAPHVIZ
        
        # 提取任务信息
        tasks = []
        dependencies = {}
        parallel_groups = []
        
        for task in template.tasks:
            tasks.append(task.tool_name)
            if task.dependencies:
                dependencies[task.tool_name] = task.dependencies
        
        # 可视化
        result = visualizer.visualize_dag_structure(
            template.name,
            tasks,
            dependencies,
            parallel_groups,
            viz_format
        )
        
        return result.content
    
    except Exception as e:
        logger.error(f"DAG可视化失败: {e}")
        return f"❌ 可视化失败: {str(e)}"


async def shutdown_workflow_components():
    """关闭工作流程组件"""
    global _user_cache_instance, _workflow_monitor_instance, _dag_visualizer_instance
    
    logger.info("开始关闭工作流程组件...")
    
    if _user_cache_instance:
        try:
            await _user_cache_instance.shutdown()
            logger.info("✅ IntelligentUserCache已关闭")
        except Exception as e:
            logger.error(f"❌ IntelligentUserCache关闭失败: {e}")
    
    _user_cache_instance = None
    _workflow_monitor_instance = None
    _dag_visualizer_instance = None
    
    logger.info("✅ 工作流程组件已全部关闭")


# 导出
__all__ = [
    "execute_eleven_step_workflow",
    "execute_eleven_step_workflow_stream",
    "get_workflow_statistics",
    "visualize_dag_template",
    "shutdown_workflow_components"
]
