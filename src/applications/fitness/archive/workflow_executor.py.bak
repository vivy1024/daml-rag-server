async def execute_eleven_step_workflow(
    query_text: str,
    user_id: str,
    domain: str = "fitness",
    user_profile: Optional[Dict[str, Any]] = None,
    session_id: Optional[str] = None
) -> Dict[str, Any]:
    """
    执行完整的11步工作流程

    步骤1：预加载用户档案（0延迟）
    步骤2：会话记录存储（用于Few-Shot）
    步骤3：检查会员权限
    步骤4：BGE第一次调用（查询复杂度分类）
    步骤5：智能模型选择（三段式决策）
    步骤6：Few-Shot检索（推理时学习）
    步骤7：DAG编排器（意图匹配+依赖解析）
    步骤8：三层检索（无幻觉核心）
    步骤9：工具结果汇总（结构化JSON）
    步骤10：LLM生成最终回答（翻译模式）
    步骤11：记录交互（用于未来学习）

    Args:
        query_text: 用户查询文本
        user_id: 用户ID
        domain: 领域（默认fitness）
        user_profile: 用户档案（可选，如果未提供会自动加载）
        session_id: 会话ID（可选，如果未提供会自动生成）

    Returns:
        Dict[str, Any]: 工作流程执行结果
    """
    start_time = time.time()
    request_id = str(uuid.uuid4())[:8]

    logger.info(f"🚀 [请求ID: {request_id}] 开始执行11步工作流程（增强版）")
    logger.info(f"📝 查询: {query_text[:50]}...")
    logger.info(f"👤 用户: {user_id}")

    # ✅ 新增：初始化性能优化组件（如果尚未初始化）
    initialize_performance_components()
    logger.info(f"📊 [请求ID: {request_id}] 性能优化组件已初始化")
    
    # ✅ 新增：初始化连接池（如果尚未初始化）
    connection_pool_manager = get_connection_pool_manager()
    if not connection_pool_manager._initialized:
        try:
            await connection_pool_manager.initialize()
            logger.info(f"✅ [请求ID: {request_id}] 连接池管理器已初始化（MySQL + Neo4j）")
        except Exception as e:
            logger.warning(f"⚠️ [请求ID: {request_id}] 连接池初始化失败: {e}，将使用降级模式")
            # 不抛出异常，允许工作流继续（使用直接连接而非连接池）

    # 初始化监控会话
    workflow_monitor = get_workflow_monitor()
    monitor_session_id = workflow_monitor.start_session(
        user_id=user_id,
        query=query_text,
        metadata={"session_id": session_id, "request_id": request_id}
    )
    
    # ✅ 新增：初始化性能监控器
    performance_monitor = get_performance_monitor()
    perf_context = performance_monitor.start_workflow(
        request_id=request_id,
        user_id=str(user_id)
    )
    logger.info(f"📊 [请求ID: {request_id}] 性能监控已启动")

    try:
        # 导入所需的组件
        from .clients.backend_client import BackendClient
        from ...framework.models.query_complexity_classifier import QueryComplexityClassifier

        backend_client = BackendClient()

        # ===== 步骤1-2：并行执行（优化TTFB） =====
        logger.info(f"[{request_id}] 步骤1-2: 并行执行（用户档案加载 + 会话记录存储）")
        
        # ✅ 新增：使用并行步骤执行器
        parallel_executor = ParallelStepExecutor(
            request_id=request_id,
            default_timeout=10.0,  # 10秒超时
            enable_fallback=True,
            enable_monitoring=True
        )
        
        # 定义步骤1：预加载用户档案
        async def load_user_profile():
            """步骤1：预加载用户档案（混合方案：缓存优先 + MCP工具降级）"""
            workflow_monitor.start_step(monitor_session_id, WorkflowStep.USER_PROFILE_LOADING)
            nonlocal user_profile
            
            if not user_profile and user_id:
                try:
                    # 健壮的user_id转换逻辑
                    if isinstance(user_id, int):
                        user_id_int = user_id
                    elif isinstance(user_id, str) and user_id.isdigit():
                        user_id_int = int(user_id)
                    else:
                        logger.warning(f"⚠️ 无效的user_id: {user_id}")
                        user_id_int = None

                    if user_id_int:
                        # ✅ 主路径：使用IntelligentCacheManager获取用户档案
                        cache_manager = get_cache_manager()
                        cache_key = f"user_profile:{user_id_int}"
                        
                        # 定义数据获取函数
                        async def fetch_user_profile():
                            """从数据库获取用户档案"""
                            user_cache = get_user_cache(backend_client=backend_client)
                            return await user_cache.get_user_profile(str(user_id_int))
                        
                        # ✅ 使用measure()上下文管理器记录缓存操作
                        with performance_monitor.measure("cache_get_user_profile"):
                            try:
                                # 使用缓存管理器获取（自动处理L1/L2/L3缓存）
                                user_profile = await cache_manager.get(
                                    key=cache_key,
                                    fetch_func=fetch_user_profile,
                                    ttl=300  # 5分钟TTL
                                )
                                
                                if user_profile:
                                    logger.info(f"✅ [{request_id}] 步骤1完成: 用户档案已加载（主路径）")
                                else:
                                    logger.warning(f"⚠️ [{request_id}] 步骤1: 主路径返回空档案")
                                    
                            except Exception as cache_error:
                                # ✅ 降级路径：使用用户档案MCP工具
                                logger.warning(f"⚠️ [{request_id}] 步骤1: 主路径失败，使用MCP工具降级")
                                logger.warning(f"   错误: {cache_error}")
                                
                                try:
                                    # 调用用户档案MCP工具
                                    mcp_result = await mcp_tool_manager.call_tool(
                                        tool_name="get_user_profile",
                                        params={"user_id": str(user_id_int)}
                                    )
                                    
                                    if mcp_result and mcp_result.get("success"):
                                        user_profile = mcp_result.get("profile", {})
                                        logger.info(f"✅ [{request_id}] 步骤1完成: 用户档案已加载（MCP降级）")
                                    else:
                                        logger.warning(f"⚠️ [{request_id}] 步骤1: MCP工具也失败")
                                        user_profile = None
                                        
                                except Exception as mcp_error:
                                    logger.error(f"❌ [{request_id}] 步骤1: MCP工具降级失败: {mcp_error}")
                                    user_profile = None
                    else:
                        logger.info(f"✅ [{request_id}] 步骤1完成: 跳过用户档案加载")
                        
                except Exception as e:
                    logger.warning(f"⚠️ [{request_id}] 步骤1: 用户档案加载失败: {e}")
                    logger.info(f"✅ [{request_id}] 步骤1完成: 继续使用匿名模式")
                    user_profile = None
                    # 不抛出异常，允许工作流继续
            
            workflow_monitor.finish_step(
                monitor_session_id,
                WorkflowStep.USER_PROFILE_LOADING,
                success=bool(user_profile),
                input_size=len(str(user_id)),
                output_size=len(str(user_profile)) if user_profile else 0
            )
            return user_profile
        
        # 定义步骤2：会话记录存储
        async def create_session():
            """步骤2：会话记录存储（快速执行）"""
            nonlocal session_id
            if not session_id:
                session_id = f"session_{user_id or 'anonymous'}_{int(time.time())}"
            
            logger.info(f"✅ [{request_id}] 步骤2完成: 会话ID={session_id[:16]}...")
            return session_id
        
        # 使用并行执行器执行步骤1和步骤2
        parallel_result = await parallel_executor.execute_parallel_steps(
            steps=[
                (1, "预加载用户档案", load_user_profile),
                (2, "会话记录存储", create_session)
            ],
            timeout=10.0,  # 10秒超时
            continue_on_error=True  # 即使某个步骤失败也继续
        )
        
        # 提取步骤结果
        user_profile = parallel_executor.extract_step_data(parallel_result, 1, default=None)
        session_id = parallel_executor.extract_step_data(parallel_result, 2, default=f"session_{user_id or 'anonymous'}_{int(time.time())}")
        
        # 记录并行执行摘要
        logger.info(
            f"✅ [{request_id}] 步骤1-2并行完成: "
            f"总耗时={parallel_result.total_duration_ms:.0f}ms, "
            f"成功={parallel_result.metadata['successful_steps']}/{parallel_result.metadata['total_steps']}, "
            f"失败={parallel_result.metadata['failed_steps']}"
        )
        
        # 记录失败的步骤（如果有）
        if parallel_result.failed_steps:
            for failed_step in parallel_result.failed_steps:
                logger.warning(
                    f"⚠️ [{request_id}] 步骤{failed_step.step_number} {failed_step.step_name} 失败: "
                    f"{failed_step.error}"
                )
        
        # ✅ 新增：记录步骤1-2的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=1,
            step_name="预加载用户档案",
            duration_ms=parallel_result.total_duration_ms / 2,  # 平均分配时间
            success=user_profile is not None,
            metadata={
                "profile_loaded": bool(user_profile),
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )
        performance_monitor.record_step(
            context=perf_context,
            step_number=2,
            step_name="会话记录存储",
            duration_ms=parallel_result.total_duration_ms / 2,  # 平均分配时间
            success=True,
            metadata={
                "session_id": session_id[:16] if session_id else None,
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )

        # ===== 步骤3-4：并行执行（优化TTFB） =====
        logger.info(f"[{request_id}] 步骤3-4: 并行执行（会员权限检查 + BGE复杂度分类）")
        
        # 定义步骤3：检查会员权限
        async def check_membership():
            """步骤3：检查会员权限（带完整错误处理 + 缓存管理器集成）"""
            workflow_monitor.start_step(monitor_session_id, WorkflowStep.MEMBERSHIP_CHECK)
            membership = None
            if user_id:
                try:
                    if isinstance(user_id, int):
                        user_id_int = user_id
                    elif isinstance(user_id, str) and user_id.isdigit():
                        user_id_int = int(user_id)
                    else:
                        user_id_int = None

                    if user_id_int:
                        # ✅ 新增：使用IntelligentCacheManager获取会员权限
                        cache_manager = get_cache_manager()
                        cache_key = f"user_membership:{user_id_int}"
                        
                        # 定义数据获取函数
                        async def fetch_membership():
                            """从数据库获取会员权限"""
                            membership_cache = get_membership_cache(backend_client=backend_client)
                            return await membership_cache.get_user_membership(str(user_id_int))
                        
                        # ✅ 新增：使用measure()上下文管理器记录缓存操作
                        with performance_monitor.measure("cache_get_membership"):
                            # 使用缓存管理器获取（自动处理L1/L2/L3缓存）
                            membership = await cache_manager.get(
                                key=cache_key,
                                fetch_func=fetch_membership,
                                ttl=600  # 10分钟TTL
                            )
                        
                        if membership:
                            tier = membership.get('tier', 'free')
                            is_fallback = membership.get('_fallback', False)
                            if is_fallback:
                                logger.info(f"✅ [{request_id}] 步骤3完成: 会员等级={tier}（降级）")
                            else:
                                logger.info(f"✅ [{request_id}] 步骤3完成: 会员等级={tier}（缓存管理器）")
                        else:
                            logger.info(f"✅ [{request_id}] 步骤3完成: 会员信息未找到")
                    else:
                        logger.info(f"✅ [{request_id}] 步骤3完成: 匿名用户")
                except Exception as e:
                    logger.warning(f"⚠️ [{request_id}] 步骤3: 会员权限检查失败: {e}")
                    logger.info(f"✅ [{request_id}] 步骤3完成: 继续匿名模式")
                    # 不抛出异常，允许工作流继续
            
            workflow_monitor.finish_step(
                monitor_session_id,
                WorkflowStep.MEMBERSHIP_CHECK,
                success=bool(membership)
            )
            return membership
        
        # 定义步骤4：BGE复杂度分类
        async def classify_complexity():
            """步骤4：BGE复杂度分类（带完整错误处理 + 缓存管理器集成）"""
            workflow_monitor.start_step(monitor_session_id, WorkflowStep.BGE_COMPLEXITY_CLASSIFICATION)
            
            try:
                # ✅ 新增：使用IntelligentCacheManager缓存BGE分类结果
                cache_manager = get_cache_manager()
                
                # 生成缓存键（基于查询文本的哈希）
                import hashlib
                query_hash = hashlib.md5(query_text.encode('utf-8')).hexdigest()
                cache_key = f"bge_complexity:{query_hash}"
                
                # 定义数据获取函数
                async def fetch_complexity():
                    """执行BGE复杂度分类"""
                    classifier = QueryComplexityClassifier()
                    return classifier.classify_complexity(query_text)
                
                # ✅ 新增：使用measure()上下文管理器记录BGE分类操作
                with performance_monitor.measure("bge_complexity_classification"):
                    # 使用缓存管理器获取（自动处理L1/L2/L3缓存）
                    result = await cache_manager.get(
                        key=cache_key,
                        fetch_func=fetch_complexity,
                        ttl=3600  # 1小时TTL（相同查询的分类结果可以缓存较长时间）
                    )
                
                # 提取结果
                is_complex = result.is_complex
                similarity = result.similarity
                reason = result.reason
                
                logger.info(
                    f"✅ [{request_id}] 步骤4完成: 复杂度={'复杂' if is_complex else '简单'}, "
                    f"相似度={similarity:.2f}, 耗时={result.duration_ms:.2f}ms, "
                    f"缓存命中={result.cache_hit}（缓存管理器）"
                )
                
                workflow_monitor.finish_step(
                    monitor_session_id,
                    WorkflowStep.BGE_COMPLEXITY_CLASSIFICATION,
                    success=True,
                    metadata={
                        "is_complex": is_complex,
                        "similarity": similarity,
                        "reason": reason,
                        "cache_hit": result.cache_hit,
                        "duration_ms": result.duration_ms,
                        "fallback_used": result.fallback_used
                    }
                )
                return is_complex, similarity, reason
                
            except Exception as e:
                logger.warning(f"⚠️ [{request_id}] 步骤4: BGE复杂度分类失败: {e}")
                # 降级策略：默认为简单查询
                logger.info(f"✅ [{request_id}] 步骤4完成: 使用降级策略（默认简单查询）")
                
                workflow_monitor.finish_step(
                    monitor_session_id,
                    WorkflowStep.BGE_COMPLEXITY_CLASSIFICATION,
                    success=False,
                    metadata={
                        "is_complex": False,
                        "similarity": 0.0,
                        "reason": "降级策略",
                        "fallback_used": True,
                        "error": str(e)
                    }
                )
                return False, 0.0, "降级策略"
        
        # 使用并行执行器执行步骤3和步骤4
        parallel_result = await parallel_executor.execute_parallel_steps(
            steps=[
                (3, "检查会员权限", check_membership),
                (4, "BGE复杂度分类", classify_complexity)
            ],
            timeout=10.0,  # 10秒超时
            continue_on_error=True  # 即使某个步骤失败也继续
        )
        
        # 提取步骤结果
        membership = parallel_executor.extract_step_data(parallel_result, 3, default=None)
        complexity_result = parallel_executor.extract_step_data(parallel_result, 4, default=(False, 0.0, "降级策略"))
        is_complex, similarity, reason = complexity_result
        
        # 记录并行执行摘要
        logger.info(
            f"✅ [{request_id}] 步骤3-4并行完成: "
            f"总耗时={parallel_result.total_duration_ms:.0f}ms, "
            f"成功={parallel_result.metadata['successful_steps']}/{parallel_result.metadata['total_steps']}, "
            f"失败={parallel_result.metadata['failed_steps']}"
        )
        
        # 记录失败的步骤（如果有）
        if parallel_result.failed_steps:
            for failed_step in parallel_result.failed_steps:
                logger.warning(
                    f"⚠️ [{request_id}] 步骤{failed_step.step_number} {failed_step.step_name} 失败: "
                    f"{failed_step.error}"
                )
        
        # ✅ 新增：记录步骤3-4的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=3,
            step_name="检查会员权限",
            duration_ms=parallel_result.total_duration_ms / 2,  # 平均分配时间
            success=membership is not None,
            metadata={
                "tier": membership.get('tier', 'unknown') if membership else None,
                "is_fallback": membership.get('_fallback', False) if membership else False,
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )
        performance_monitor.record_step(
            context=perf_context,
            step_number=4,
            step_name="BGE复杂度分类",
            duration_ms=parallel_result.total_duration_ms / 2,  # 平均分配时间
            success=True,
            metadata={
                "is_complex": is_complex,
                "similarity": similarity,
                "reason": reason,
                "parallel_execution": True,
                "total_parallel_duration_ms": parallel_result.total_duration_ms
            }
        )

        # ===== 步骤5：智能模型选择（三段式决策） =====
        logger.info(f"[{request_id}] 步骤5: 智能模型选择")
        step5_start = time.time()
        model_choice = "teacher" if is_complex or similarity >= 0.7 else "student"
        step5_duration = (time.time() - step5_start) * 1000
        logger.info(f"✅ [{request_id}] 步骤5完成: 选择模型={model_choice}")
        
        # ✅ 新增：记录步骤5的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=5,
            step_name="智能模型选择",
            duration_ms=step5_duration,
            success=True,
            metadata={"model": model_choice}
        )

        # ===== 步骤6：Few-Shot检索（推理时学习 + 缓存管理器集成） =====
        logger.info(f"[{request_id}] 步骤6: Few-Shot检索")
        step6_start = time.time()
        few_shot_count = 0
        few_shot_examples = []
        try:
            # ✅ 新增：使用IntelligentCacheManager缓存Few-Shot示例
            cache_manager = get_cache_manager()
            
            # 生成缓存键（基于查询文本和用户档案的哈希）
            import hashlib
            cache_key_data = f"{query_text}:{user_profile.get('fitness_goal', '') if user_profile else ''}:{domain}"
            cache_hash = hashlib.md5(cache_key_data.encode('utf-8')).hexdigest()
            cache_key = f"few_shot:{cache_hash}"
            
            # 定义数据获取函数
            async def fetch_few_shot_examples():
                """执行Few-Shot检索"""
                from ...framework.retrieval.enhanced_few_shot_retriever import EnhancedFewShotRetriever

                few_shot_retriever = EnhancedFewShotRetriever(
                    vector_store=None,
                    backend_client=backend_client
                )

                best_practices = await few_shot_retriever.get_best_practices(
                    query=query_text,
                    user_profile=user_profile,
                    domain=domain,
                    top_k=3
                )

                examples = []
                for match in best_practices:
                    bp = match.best_practice
                    formatted = few_shot_retriever.best_practices_retriever.format_best_practice(
                        bp, user_profile,
                        {"exercise_name": "动作", "goal": user_profile.get("fitness_goal", "健康") if user_profile else "健康"}
                    )

                    examples.append({
                        "query": bp.query_pattern,
                        "response": formatted,
                        "match_score": match.match_score,
                        "pattern_id": bp.pattern_id
                    })
                
                return examples
            
            # ✅ 新增：使用measure()上下文管理器记录Few-Shot检索操作
            with performance_monitor.measure("few_shot_retrieval"):
                # 使用缓存管理器获取（自动处理L1/L2/L3缓存）
                few_shot_examples = await cache_manager.get(
                    key=cache_key,
                    fetch_func=fetch_few_shot_examples,
                    ttl=1800  # 30分钟TTL（Few-Shot示例可以缓存较长时间）
                )
            
            if few_shot_examples is None:
                few_shot_examples = []
            
            few_shot_count = len(few_shot_examples)
            logger.info(f"✅ [{request_id}] 步骤6完成: {few_shot_count}个最佳实践（缓存管理器）")

        except Exception as e:
            logger.warning(f"⚠️ [{request_id}] 步骤6: Few-Shot检索异常: {e}")
            logger.info(f"✅ [{request_id}] 步骤6完成: 使用空结果继续")
            few_shot_examples = []
        
        step6_duration = (time.time() - step6_start) * 1000
        
        # ✅ 新增：记录步骤6的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=6,
            step_name="Few-Shot检索",
            duration_ms=step6_duration,
            success=len(few_shot_examples) > 0,
            metadata={"examples_count": len(few_shot_examples)}
        )


        # ===== 步骤6.5：LLM选择DAG模板 =====
        logger.info(f"[{request_id}] 步骤6.5: LLM选择DAG模板")
        step6_5_start = time.time()
        selected_template_id = None
        try:
            from .llm_decision_engine import LLMDecisionEngine, DAGSelectionRequest
            from .dag_template_system import DAGTemplateManager
            
            # 初始化决策引擎
            template_manager = DAGTemplateManager()
            decision_engine = LLMDecisionEngine(template_manager)
            
            # 创建选择请求
            selection_request = DAGSelectionRequest(
                user_query=query_text,
                user_profile=user_profile or {},
                available_templates=template_manager.get_all_templates(),
                session_context={"session_id": session_id},
                few_shot_examples=few_shot_examples
            )
            
            # LLM选择DAG模板
            selection_result = await decision_engine.select_dag_template(selection_request)
            selected_template_id = selection_result.selected_template_id
            
            logger.info(f"✅ [{request_id}] 步骤6.5完成: 选择模板={selected_template_id}, 置信度={selection_result.confidence:.2f}")
            logger.info(f"   - 选择理由: {selection_result.selection_reason}")
            
        except Exception as e:
            logger.warning(f"⚠️ [{request_id}] 步骤6.5: LLM选择失败: {e}")
            # 降级到规则匹配
            from .dag_template_system import DAGTemplateManager
            template_manager = DAGTemplateManager()
            selected_template_id = template_manager.match_template_by_keywords(query_text)
            logger.info(f"✅ [{request_id}] 步骤6.5完成: 使用降级策略，选择模板={selected_template_id}")
        
        step6_5_duration = (time.time() - step6_5_start) * 1000
        
        # ✅ 新增：记录步骤6.5的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=7,  # 使用7作为步骤编号（6.5 -> 7）
            step_name="LLM选择DAG模板",
            duration_ms=step6_5_duration,
            success=selected_template_id is not None,
            metadata={"template_id": selected_template_id}
        )

        # ===== 步骤7-8：DAG编排执行 =====
        logger.info(f"[{request_id}] 步骤7-8: DAG编排执行")
        step7_8_start = time.time()
        dag_results = {}  # 初始化dag_results，防止未定义错误
        try:
            from .enhanced_dag_orchestrator import EnhancedDAGOrchestrator
            from .dag_template_system import DAGTemplateManager
            from ...framework.clients.mcp_tool_manager import MCPToolManager
            from ...framework.clients.mcp_client_v2 import create_configurable_mcp_client
            from .mcp_tools.registry import MCPToolRegistry
            from .mcp_tools import initialize_all_tools
            
            # 初始化MCP客户端（连接到实际的MCP服务）
            mcp_client = create_configurable_mcp_client()
            
            # 尝试连接MCP客户端
            try:
                await mcp_client.connect()
                logger.info(f"✅ [{request_id}] MCP客户端连接成功")
            except Exception as e:
                logger.warning(f"⚠️ [{request_id}] MCP客户端连接失败: {e}，将使用模拟模式")
                mcp_client = None
            
            # 初始化数据库客户端和检索引擎
            from ...framework.clients.neo4j_client import Neo4jClient
            from ...framework.clients.qdrant_client import QdrantClient
            from ...framework.retrieval.true_three_layer_engine import TrueThreeLayerEngine
            
            # 创建客户端实例并连接
            neo4j_client = Neo4jClient()
            await neo4j_client.connect()  # ✅ 修复：必须调用connect()建立连接
            qdrant_client = QdrantClient()
            # ✅ 新增：传入连接池管理器到TrueThreeLayerEngine
            connection_pool_manager = get_connection_pool_manager()
            three_layer_engine = TrueThreeLayerEngine(connection_pool_manager=connection_pool_manager)
            logger.info(f"✅ [{request_id}] 数据库客户端和检索引擎初始化完成（使用连接池）")
            
            # 初始化Python工具注册表（传入必需的客户端）
            python_tool_registry = MCPToolRegistry()
            initialize_all_tools(
                python_tool_registry,
                neo4j_client=neo4j_client,
                qdrant_client=qdrant_client,
                three_layer_engine=three_layer_engine,
                backend_client=backend_client,  # ✅ v1.1.0新增：用于find_similar_training_cases
                vector_store=qdrant_client  # ✅ v1.1.0新增：用于find_similar_training_cases
            )
            logger.info(f"✅ [{request_id}] Python工具注册表初始化完成，共{python_tool_registry.get_tool_count()}个工具")
            
            # 初始化MCP工具管理器（传入MCP客户端和Python工具注册表）
            mcp_tool_manager = MCPToolManager(
                mcp_client=mcp_client,
                python_tool_registry=python_tool_registry
            )
            
            # 初始化DAG编排器（传入MCP工具管理器）
            template_manager = DAGTemplateManager()
            dag_orchestrator = EnhancedDAGOrchestrator(
                template_manager=template_manager,
                mcp_orchestrator=mcp_tool_manager  # ⚠️ 关键修复：传入MCP工具管理器
            )
            
            # ✅ 新增：使用measure()上下文管理器记录DAG执行操作
            with performance_monitor.measure("dag_template_execution"):
                # 执行DAG模板（传递context，包含用户档案）
                dag_execution_result = await dag_orchestrator.execute_template(
                    template_id=selected_template_id,
                    user_profile=user_profile or {},
                    session_context={
                        "session_id": session_id,
                        "query": query_text,
                        "_context": {
                            "user_profile": user_profile  # ✅ 传递预加载的用户档案
                        }
                    },
                    cached_results=None
                )
            
            # 提取结果
            dag_results = dag_execution_result.results
            
            if dag_results:
                result = {
                    "results": _convert_dag_results_to_graphrag_format(dag_results),
                    "query_type": "dag_orchestration",
                    "domain": domain,
                    "count": len(dag_results),
                    "dag_tasks": list(dag_results.keys()),
                    "template_id": selected_template_id,
                    "tasks_completed": dag_execution_result.tasks_completed,
                    "tasks_failed": dag_execution_result.tasks_failed
                }
                logger.info(f"✅ [{request_id}] 步骤7-8完成: {dag_execution_result.tasks_completed}个任务成功")
                
                step7_8_duration = (time.time() - step7_8_start) * 1000
                
                # ✅ 新增：记录步骤7-8的性能
                performance_monitor.record_step(
                    context=perf_context,
                    step_number=8,
                    step_name="DAG编排执行",
                    duration_ms=step7_8_duration,
                    success=True,
                    metadata={
                        "template_id": selected_template_id,
                        "tasks_completed": dag_execution_result.tasks_completed,
                        "tasks_failed": dag_execution_result.tasks_failed
                    }
                )
            else:
                logger.warning(f"⚠️ [{request_id}] 步骤7-8: DAG任务执行失败，回退到三层检索")
                result = await _fallback_to_three_layer_search(query_text, domain, user_id, user_profile)
                logger.info(f"✅ [{request_id}] 步骤7-8完成: 三层检索回退")
                
                step7_8_duration = (time.time() - step7_8_start) * 1000
                
                # ✅ 新增：记录步骤7-8的性能（回退）
                performance_monitor.record_step(
                    context=perf_context,
                    step_number=8,
                    step_name="DAG编排执行",
                    duration_ms=step7_8_duration,
                    success=False,
                    metadata={"fallback": "three_layer_search"}
                )
                
        except Exception as e:
            logger.warning(f"⚠️ [{request_id}] 步骤7-8: DAG任务执行异常: {e}")
            result = {
                "results": [],
                "query_type": "dag_orchestration",
                "domain": domain,
                "count": 0,
                "error": str(e)
            }
            logger.info(f"✅ [{request_id}] 步骤7-8完成: 使用错误恢复模式")
            
            step7_8_duration = (time.time() - step7_8_start) * 1000
            
            # ✅ 新增：记录步骤7-8的性能（异常）
            performance_monitor.record_step(
                context=perf_context,
                step_number=8,
                step_name="DAG编排执行",
                duration_ms=step7_8_duration,
                success=False,
                error=str(e),
                metadata={"error_recovery": True}
            )

        # ===== 步骤9：工具结果汇总（结构化JSON） =====
        logger.info(f"[{request_id}] 步骤9: 工具结果汇总")
        step9_start = time.time()
        
        # 汇总所有数据（包括MCP工具结果和工作流程数据）
        all_data = {}
        
        # 1. 从DAG执行结果中提取实际的MCP工具调用结果
        mcp_tools_called = []
        if dag_results:
            for task_name, task_result in dag_results.items():
                # ⚠️ 关键修复：只记录真正的MCP工具（在MCP_TASK_TYPES中）
                # 排除工作流程步骤（get_user_profile, semantic_search等）
                if task_name in MCP_TASK_TYPES:
                    if task_result and isinstance(task_result, dict):
                        all_data[task_name] = task_result
                        # ⚠️ 修复：更严格的成功判断
                        # 1. 检查是否有error字段（有error说明失败）
                        # 2. 检查success字段是否明确为True
                        # 3. 检查是否是fallback结果（fallback说明原始调用失败）
                        has_error = "error" in task_result and task_result["error"] is not None
                        is_success = task_result.get("success", False) is True
                        is_fallback = task_result.get("fallback", False) or task_result.get("fallback_used", False)
                        
                        if is_success and not has_error and not is_fallback:
                            mcp_tools_called.append(task_name)
                            logger.info(f"   ✅ MCP工具: {task_name} (成功)")
                        else:
                            error_msg = task_result.get('error', 'Unknown')
                            logger.warning(f"   ⚠️ MCP工具: {task_name} (失败: {error_msg})")
                # 工作流程步骤数据也保存到all_data，但不记录为MCP工具
                elif task_name in WORKFLOW_STEPS:
                    if task_result and isinstance(task_result, dict):
                        all_data[task_name] = task_result
                        logger.debug(f"   📊 工作流程数据: {task_name}")
                else:
                    # 未知任务类型，记录警告
                    logger.warning(f"   ⚠️ 未知任务类型: {task_name}")
                    all_data[task_name] = task_result
        
        # 2. 添加用户档案（工作流程数据，不是MCP工具）
        if user_profile:
            all_data["user_profile"] = user_profile
            logger.debug(f"   📊 工作流程数据: user_profile")
        
        # 3. 添加会员信息（工作流程数据，不是MCP工具）
        if membership:
            all_data["user_membership"] = membership
            logger.debug(f"   📊 工作流程数据: user_membership")
        
        # 4. 添加检索结果（工作流程数据，不是MCP工具）
        if result and result.get("results"):
            all_data["retrieval_results"] = {
                "results": result.get("results", []),
                "count": result.get("count", 0),
                "query_type": result.get("query_type", "unknown")
            }
            logger.debug(f"   📊 工作流程数据: retrieval_results ({result.get('count', 0)}个)")
        
        logger.info(f"✅ [{request_id}] 步骤9完成:")
        logger.info(f"   - MCP工具调用: {len(mcp_tools_called)}个 ({', '.join(mcp_tools_called) if mcp_tools_called else '无'})")
        logger.info(f"   - 工作流程数据: {len([k for k in all_data.keys() if k in WORKFLOW_STEPS or k in ['user_profile', 'user_membership', 'retrieval_results']])}项")
        logger.info(f"   - 总数据项: {len(all_data)}个")
        
        step9_duration = (time.time() - step9_start) * 1000
        
        # ✅ 新增：记录步骤9的性能
        performance_monitor.record_step(
            context=perf_context,
            step_number=9,
            step_name="工具结果汇总",
            duration_ms=step9_duration,
            success=True,
            metadata={
                "mcp_tools_count": len(mcp_tools_called),
                "workflow_data_count": len([k for k in all_data.keys() if k in WORKFLOW_STEPS or k in ['user_profile', 'user_membership', 'retrieval_results']]),
                "total_data_items": len(all_data)
            }
        )

        # ===== 步骤10：LLM生成最终回答（使用配置管理器） =====
        logger.info(f"[{request_id}] 步骤10: LLM生成回答（模板={selected_template_id}）")
        step10_start = time.time()
        
        # 1. 初始化配置管理器
        from ...framework.config.llm_response_config_manager import LLMResponseConfigManager
        
        config_manager = LLMResponseConfigManager()
        logger.debug(f"   - 配置管理器初始化完成")
        
        # 2. 获取模板配置
        llm_response_config = config_manager.get_config(selected_template_id)
        logger.info(f"   - 使用模板配置: {selected_template_id}")
        logger.info(f"   - max_tokens={llm_response_config.max_tokens}, temperature={llm_response_config.temperature}")
        logger.info(f"   - response_style={llm_response_config.response_style}, tone={llm_response_config.tone}")
        
        # 3. 从DAG模板获取response_hint
        from .dag_template_system import DAGTemplateManager
        template_manager = DAGTemplateManager()
        selected_template = template_manager.get_template(selected_template_id)
        response_hint = selected_template.response_hint if selected_template else "请提供专业的分析和建议"
        
        # 4. 构建提示词（使用配置管理器）
        # 准备用户档案字符串（避免序列化错误）
        user_profile_for_prompt = '未提供'
        if user_profile:
            try:
                # 创建可序列化的副本
                serializable_profile = {}
                for key, value in user_profile.items():
                    if key == 'membership' and hasattr(value, '__dict__'):
                        if hasattr(value, 'tier'):
                            serializable_profile['membership_tier'] = str(value.tier)
                    elif isinstance(value, (str, int, float, bool, list, dict, type(None))):
                        serializable_profile[key] = value
                    else:
                        serializable_profile[key] = str(value)
                user_profile_for_prompt = json.dumps(serializable_profile, ensure_ascii=False)
            except Exception as e:
                logger.warning(f"用户档案序列化失败: {e}")
                user_profile_for_prompt = str(user_profile)
        
        # 准备MCP工具结果（用于嵌入结构化数据）
        # ✅ 新增：集成WeeklyPlanGenerator实现分周输出
        mcp_tools_result_json = "{}"
        weekly_plan_output = None  # 存储分周计划输出
        
        if mcp_tools_called and dag_results:
            try:
                # 提取professional_program_designer的结果（如果有）
                if "professional_program_designer" in dag_results:
                    program_result = dag_results["professional_program_designer"]
                    if program_result and not program_result.get("error"):
                        # ✅ 新增：使用WeeklyPlanGenerator转换为单周输出
                        # Requirements: 10.1 - 只输出第1周完整计划
                        try:
                            from .services.weekly_plan_generator import WeeklyPlanGenerator
                            
                            weekly_generator = WeeklyPlanGenerator()
                            
                            # 获取总周数（默认4周）
                            total_weeks = program_result.get("program_overview", {}).get("training_weeks", 4)
                            
                            # 生成第1周计划
                            weekly_plan = weekly_generator.generate_first_week(
                                full_program=program_result,
                                user_profile=user_profile,
                                total_weeks=total_weeks
                            )
                            
                            # 转换为输出格式
                            weekly_plan_output = weekly_generator.convert_to_output_format(weekly_plan)
                            
                            # 将分周计划添加到结果中
                            program_result["weekly_plan_output"] = weekly_plan_output
                            program_result["output_mode"] = "weekly"  # 标记为分周输出模式
                            
                            logger.info(
                                f"   - 分周输出: 第{weekly_plan_output['week_number']}周/"
                                f"{weekly_plan_output['total_weeks']}周, "
                                f"阶段={weekly_plan_output['phase']}, "
                                f"总组数={weekly_plan_output['total_weekly_sets']}"
                            )
                            
                        except Exception as weekly_gen_error:
                            logger.warning(f"分周计划生成失败，使用完整输出: {weekly_gen_error}")
                            # 降级：使用完整输出
                            program_result["output_mode"] = "full"
                        
                        mcp_tools_result_json = json.dumps(program_result, ensure_ascii=False, indent=2)
                        logger.info(f"   - 提取到训练计划数据: {len(mcp_tools_result_json)}字节")
            except Exception as e:
                logger.warning(f"提取MCP工具结果失败: {e}")
        
        system_prompt = config_manager.build_prompt(
            template_id=selected_template_id,
            query=query_text,
            user_profile=user_profile_for_prompt,
            response_hint=response_hint,
            mcp_tools_count=len(mcp_tools_called),
            retrieval_count=len(result.get('results', [])),
            mcp_tools_result=mcp_tools_result_json  # 添加MCP工具结果
        )
        
        logger.info(f"   - 提示词长度: {len(system_prompt)}字")
        logger.info(f"   - 响应约束: {llm_response_config.length_constraint}")

        # 5. 调用LLM（使用降级管理器）
        try:
            from ...framework.clients.llm_fallback_manager import LLMFallbackManager, LLMRequest, BackendType
            from ...framework.clients.llm_client import LLMConfig

            # 初始化降级管理器
            fallback_manager = LLMFallbackManager(
                primary_backend="deepseek",
                fallback_backends=["ollama", "template"],
                max_retries=3,
                timeout=30,
                enable_health_check=True
            )
            
            # 准备LLM请求
            few_shot_dicts = [{"query": ex["query"], "response": ex["response"]} for ex in few_shot_examples]
            
            llm_request = LLMRequest(
                query=query_text,
                few_shot_examples=few_shot_dicts,
                tool_results=all_data,
                system_prompt=system_prompt,
                max_tokens=llm_response_config.max_tokens,
                temperature=llm_response_config.temperature,
                stream=False
            )
            
            # ✅ 新增：使用measure()上下文管理器记录LLM调用操作
            with performance_monitor.measure("llm_generation"):
                # 使用降级管理器调用LLM
                llm_response = await fallback_manager.call_with_fallback(llm_request)
            
            final_response = llm_response.content
            
            # 记录降级信息
            if llm_response.fallback_used:
                logger.warning(
                    f"⚠️ [{request_id}] 步骤10: 使用了降级策略 "
                    f"(backend={llm_response.backend_used.value}, "
                    f"attempts={llm_response.attempt_count})"
                )
            
            if llm_response.error:
                logger.warning(
                    f"⚠️ [{request_id}] 步骤10: LLM调用有错误 "
                    f"(error={llm_response.error})"
                )
            
            logger.info(
                f"✅ [{request_id}] 步骤10完成: LLM生成完成 "
                f"(backend={llm_response.backend_used.value}, "
                f"fallback={llm_response.fallback_used}, "
                f"attempts={llm_response.attempt_count}, "
                f"duration={llm_response.duration_ms:.0f}ms, "
                f"length={len(final_response)}字)"
            )
            
            step10_duration = (time.time() - step10_start) * 1000
            
            # ✅ 新增：记录步骤10的性能
            performance_monitor.record_step(
                context=perf_context,
                step_number=10,
                step_name="LLM生成回答",
                duration_ms=step10_duration,
                success=not llm_response.error,
                metadata={
                    "backend": llm_response.backend_used.value,
                    "fallback_used": llm_response.fallback_used,
                    "attempt_count": llm_response.attempt_count,
                    "response_length": len(final_response)
                }
            )

        except Exception as e:
            logger.error(f"❌ [{request_id}] 步骤10: LLM生成异常: {e}", exc_info=True)
            
            # 构建更友好的降级响应，包含实际检索数据
            results_data = result.get('results', [])
            user_profile_summary = ""
            if user_profile:
                user_profile_summary = f"""
👤 **用户档案**：
- 年龄：{user_profile.get('age', '未知')}岁
- 训练经验：{user_profile.get('training_experience', '未知')}
- 训练目标：{user_profile.get('fitness_goal', '未知')}
"""
            
            retrieval_summary = ""
            if results_data:
                retrieval_summary = f"""
🔍 **检索结果**：找到 {len(results_data)} 个相关推荐
"""
                # 列出前3个结果
                for i, item in enumerate(results_data[:3], 1):
                    name = item.get('name_zh', item.get('name', '未知'))
                    retrieval_summary += f"{i}. {name}\n"
            
            final_response = f"""抱歉，AI分析功能暂时不可用（{str(e)[:100]}）。

📝 **您的查询**：{query_text}
{user_profile_summary}
✅ **已完成以下数据分析**：
{retrieval_summary}
🔍 **查询分析**：{'复杂' if is_complex else '简单'}查询
📊 **检索结果**：找到 {len(results_data)} 个相关推荐

💡 **建议**：
- 请稍后重试获取AI分析
- 或联系客服获取人工指导
- 您也可以查看上述数据自行分析

感谢您的理解！"""
            logger.info(f"✅ [{request_id}] 步骤10完成: 使用降级响应")
            
            step10_duration = (time.time() - step10_start) * 1000
            
            # ✅ 新增：记录步骤10的性能（异常）
            performance_monitor.record_step(
                context=perf_context,
                step_number=10,
                step_name="LLM生成回答",
                duration_ms=step10_duration,
                success=False,
                error=str(e),
                metadata={"fallback_response": True}
            )

        # ===== 步骤11：记录交互（用于未来学习） =====
        logger.info(f"[{request_id}] 步骤11: 记录交互")
        step11_start = time.time()
        try:
            user_id_int = int(user_id) if isinstance(user_id, str) and user_id.isdigit() else None

            if user_id_int:
                # 只记录实际调用的MCP工具（从步骤9的mcp_tools_called中）
                # mcp_tools_called已经过滤掉了工作流程步骤
                
                # 计算实际的检索层数
                retrieval_layers_count = 0
                if result and isinstance(result, dict):
                    # 检查是否有layer_results字段
                    layer_results = result.get("layer_results", {})
                    if layer_results:
                        retrieval_layers_count = len(layer_results)
                    else:
                        # 如果没有layer_results，检查是否有results字段（说明至少执行了检索）
                        if result.get("results"):
                            retrieval_layers_count = 1  # 至少执行了一层检索
                
                # ✅ 新增：使用measure()上下文管理器记录会话保存操作
                with performance_monitor.measure("save_chat_session"):
                    result_data = await backend_client.save_chat_session(
                        session_id=session_id,
                        user_id=user_id_int,
                        user_query=query_text,
                        llm_response=final_response,
                        model_used=model_choice,
                        tools_used=mcp_tools_called,  # 只记录MCP工具
                        metadata={
                            "graphrag_service": True,
                            "quality_score": None,  # 初始为None，等待用户反馈
                            "retrieval_layers": retrieval_layers_count,
                            "workflow_steps": 11,
                            "is_complex": is_complex,
                            "few_shot_count": few_shot_count,
                            "dag_template_id": selected_template_id,  # ⚠️ 修复：使用template_id替代task_graph
                            "dag_tasks_completed": dag_execution_result.tasks_completed if 'dag_execution_result' in locals() else 0,
                            "mcp_tools_count": len(mcp_tools_called),
                            "request_id": request_id,
                            "awaiting_user_feedback": True,  # 标记等待用户反馈
                            "query_type": result.get("query_type", "unknown") if result else "unknown"
                        },
                        qdrant_point_id=None  # 测试场景下为None，等待用户评分后才分配向量库ID
                    )
                logger.info(f"✅ [{request_id}] 步骤11完成: 交互记录完成 (db_id={result_data.get('id')})")
                logger.info(f"   - MCP工具: {', '.join(mcp_tools_called) if mcp_tools_called else '无'}")
                logger.info(f"   - 工具数量: {len(mcp_tools_called)}")
                logger.info(f"   - 检索层数: {retrieval_layers_count}")
                logger.info(f"   - 向量库ID: 等待用户评分反馈后分配")
                
                step11_duration = (time.time() - step11_start) * 1000
                
                # ✅ 新增：记录步骤11的性能
                performance_monitor.record_step(
                    context=perf_context,
                    step_number=11,
                    step_name="记录交互",
                    duration_ms=step11_duration,
                    success=True,
                    metadata={
                        "db_id": result_data.get('id'),
                        "mcp_tools_count": len(mcp_tools_called),
                        "retrieval_layers": retrieval_layers_count
                    }
                )
            else:
                logger.info(f"✅ [{request_id}] 步骤11完成: 匿名用户，跳过记录")
                
                step11_duration = (time.time() - step11_start) * 1000
                
                # ✅ 新增：记录步骤11的性能（匿名用户）
                performance_monitor.record_step(
                    context=perf_context,
                    step_number=11,
                    step_name="记录交互",
                    duration_ms=step11_duration,
                    success=True,
                    metadata={"anonymous": True}
                )
        except BackendValidationError as e:
            # ✅ 改进：详细解析422验证错误
            error_details = parse_validation_error(e)
            
            # 格式化并输出详细的错误日志
            error_log = format_validation_error_log(request_id, user_id_int, error_details)
            logger.warning(error_log)
            
            # 根据错误类型提供不同的处理建议
            if error_details["is_user_not_found"]:
                logger.info(f"✅ [{request_id}] 步骤11完成: 用户不存在，跳过会话保存（工作流继续）")
            else:
                logger.info(f"✅ [{request_id}] 步骤11完成: 验证失败，跳过会话保存（工作流继续）")
            
            step11_duration = (time.time() - step11_start) * 1000
            
            # ✅ 记录步骤11的性能（验证错误）
            performance_monitor.record_step(
                context=perf_context,
                step_number=11,
                step_name="记录交互",
                duration_ms=step11_duration,
                success=False,
                error=f"ValidationError: {error_details['error_message']}",
                metadata={
                    "error_type": "validation_error",
                    "error_code": error_details["error_code"],
                    "is_user_not_found": error_details["is_user_not_found"],
                    "field_errors": list(error_details["field_errors"].keys())
                }
            )
            
        except BackendNotFoundError as e:
            # ✅ 改进：处理404资源未找到错误
            logger.warning(f"⚠️ [{request_id}] 步骤11会话保存失败: 资源未找到")
            logger.warning(f"   - 用户ID: {user_id_int}")
            logger.warning(f"   - 错误详情: {e}")
            logger.info(f"✅ [{request_id}] 步骤11完成: 资源未找到，跳过会话保存（工作流继续）")
            
            step11_duration = (time.time() - step11_start) * 1000
            
            performance_monitor.record_step(
                context=perf_context,
                step_number=11,
                step_name="记录交互",
                duration_ms=step11_duration,
                success=False,
                error=f"NotFoundError: {str(e)}",
                metadata={"error_type": "not_found_error"}
            )
            
        except BackendServerError as e:
            # ✅ 改进：处理500+服务器错误
            logger.error(f"❌ [{request_id}] 步骤11会话保存失败: 后端服务器错误")
            logger.error(f"   - 用户ID: {user_id_int}")
            logger.error(f"   - 错误详情: {e}")
            logger.info(f"✅ [{request_id}] 步骤11完成: 服务器错误，跳过会话保存（工作流继续）")
            
            step11_duration = (time.time() - step11_start) * 1000
            
            performance_monitor.record_step(
                context=perf_context,
                step_number=11,
                step_name="记录交互",
                duration_ms=step11_duration,
                success=False,
                error=f"ServerError: {str(e)}",
                metadata={"error_type": "server_error"}
            )
            
        except BackendAPIError as e:
            # ✅ 改进：处理其他API错误
            logger.warning(f"⚠️ [{request_id}] 步骤11会话保存失败: API错误")
            logger.warning(f"   - 用户ID: {user_id_int}")
            logger.warning(f"   - 错误详情: {e}")
            logger.info(f"✅ [{request_id}] 步骤11完成: API错误，跳过会话保存（工作流继续）")
            
            step11_duration = (time.time() - step11_start) * 1000
            
            performance_monitor.record_step(
                context=perf_context,
                step_number=11,
                step_name="记录交互",
                duration_ms=step11_duration,
                success=False,
                error=f"APIError: {str(e)}",
                metadata={"error_type": "api_error"}
            )
            
        except Exception as e:
            # ✅ 改进：处理未预期的异常
            logger.warning(f"⚠️ [{request_id}] 步骤11会话保存失败: 未预期的错误")
            logger.warning(f"   - 用户ID: {user_id_int}")
            logger.warning(f"   - 错误类型: {type(e).__name__}")
            logger.warning(f"   - 错误详情: {e}")
            logger.info(f"✅ [{request_id}] 步骤11完成: 跳过会话保存，继续工作流程")
            
            step11_duration = (time.time() - step11_start) * 1000
            
            # ✅ 记录步骤11的性能（未预期异常）
            performance_monitor.record_step(
                context=perf_context,
                step_number=11,
                step_name="记录交互",
                duration_ms=step11_duration,
                success=False,
                error=f"{type(e).__name__}: {str(e)}",
                metadata={"error_type": "unexpected_error"}
            )

        # 构建最终结果
        processing_time = time.time() - start_time
        final_result = result.copy() if result else {}
        final_result.update({
            "eleven_step_workflow": {
                "completed": True,
                "steps_executed": 11,
                "user_profile_loaded": user_profile is not None,
                "membership_checked": membership is not None,
                "complexity_classified": is_complex,
                "model_selected": model_choice,
                "few_shot_examples": few_shot_count,
                "dag_template_id": selected_template_id,  # ⚠️ 修复：使用template_id替代task_graph
                "dag_tasks_completed": dag_execution_result.tasks_completed if 'dag_execution_result' in locals() else 0,
                "mcp_tools_called": len(mcp_tools_called),
                "final_response": final_response,
                "request_id": request_id
            },
            "success": True,
            "processing_time": processing_time
        })
        
        # ✅ 新增：完成工作流性能监控
        performance_monitor.finish_workflow(
            context=perf_context,
            success=True,
            total_duration_ms=processing_time * 1000
        )
        
        # ✅ 新增：生成性能摘要
        perf_summary = performance_monitor.get_workflow_summary(request_id)
        if perf_summary:
            logger.info(f"📊 [{request_id}] 性能摘要:")
            logger.info(f"   - 总耗时: {perf_summary['total_duration_ms']:.0f}ms")
            logger.info(f"   - 总步骤: {perf_summary['total_steps']}")
            logger.info(f"   - 性能瓶颈: {perf_summary['bottleneck_count']}个")
            
            # 输出性能瓶颈详情
            if perf_summary['bottlenecks']:
                logger.warning(f"⚠️ [{request_id}] 性能瓶颈详情:")
                for bottleneck in perf_summary['bottlenecks']:
                    logger.warning(
                        f"   - 步骤{bottleneck['step_number']} {bottleneck['step_name']}: "
                        f"{bottleneck['duration_ms']:.0f}ms"
                    )

        logger.info(f"🎉 [{request_id}] 完整11步工作流程执行成功! 耗时: {processing_time:.2f}秒")
        return final_result

    except Exception as e:
        logger.error(f"❌ [{request_id}] 11步工作流程执行失败: {e}", exc_info=True)
        
        # ✅ 新增：记录失败的工作流
        processing_time = time.time() - start_time
        performance_monitor.finish_workflow(
            context=perf_context,
            success=False,
            total_duration_ms=processing_time * 1000
        )
        
        raise


