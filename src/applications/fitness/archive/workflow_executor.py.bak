# ============ 辅助函数 ============


def _convert_dag_results_to_graphrag_format(dag_results: dict) -> list:
    """将DAG执行结果转换为GraphRAG标准格式"""
    graphrag_results = []

    if dag_results is None:
        return []

    for task_name, result in dag_results.items():
        if result is None or not isinstance(result, dict):
            continue

        if "error" in result:
            continue

        # 简单的结果转换
        graphrag_results.append({
            "id": f"{task_name}_result",
            "content": str(result),
            "score": 0.8,
            "metadata": {
                "layer": "dag_task",
                "source": task_name,
                "task": task_name
            }
        })

    return graphrag_results


