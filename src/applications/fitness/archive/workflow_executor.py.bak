# ============ 步骤11错误处理辅助函数 ============

def parse_validation_error(error: Exception) -> Dict[str, Any]:
    """
    解析验证错误，提取详细的错误信息
    
    Args:
        error: 异常对象（通常是BackendValidationError）
        
    Returns:
        Dict包含解析后的错误详情：
        - error_type: 错误类型
        - error_code: HTTP状态码
        - error_message: 错误消息
        - field_errors: 字段级别的错误详情
        - raw_error: 原始错误字符串
        - is_user_not_found: 是否是用户不存在错误
    """
    error_str = str(error)
    result = {
        "error_type": type(error).__name__,
        "error_code": None,
        "error_message": error_str,
        "field_errors": {},
        "raw_error": error_str,
        "is_user_not_found": False
    }
    
    try:
        # 尝试从错误字符串中提取JSON
        # 格式: "验证失败: {\"code\":422,\"msg\":\"验证失败\",\"data\":{\"errors\":{...}}}"
        if "验证失败:" in error_str:
            json_start = error_str.find("{")
            if json_start != -1:
                json_str = error_str[json_start:]
                error_data = json.loads(json_str)
                
                result["error_code"] = error_data.get("code")
                result["error_message"] = error_data.get("msg", "未知错误")
                
                # 提取字段级别的错误
                data = error_data.get("data", {})
                if isinstance(data, dict):
                    errors = data.get("errors", {})
                    if isinstance(errors, dict):
                        result["field_errors"] = errors
                        
                        # 检查是否是用户不存在错误
                        user_id_errors = errors.get("user_id", [])
                        if any("invalid" in str(e).lower() for e in user_id_errors):
                            result["is_user_not_found"] = True
                            
    except json.JSONDecodeError:
        # JSON解析失败，保持原始错误信息
        pass
    except Exception as parse_error:
        logger.debug(f"解析验证错误时发生异常: {parse_error}")
    
    return result


def format_validation_error_log(
    request_id: str,
    user_id: Any,
    error_details: Dict[str, Any]
) -> str:
    """
    格式化验证错误日志消息
    
    Args:
        request_id: 请求ID
        user_id: 用户ID
        error_details: 解析后的错误详情
        
    Returns:
        格式化的日志消息
    """
    lines = [
        f"⚠️ [{request_id}] 步骤11会话保存失败:",
        f"   - 用户ID: {user_id}",
        f"   - 错误类型: {error_details['error_type']}",
        f"   - 错误码: {error_details['error_code']}",
        f"   - 错误消息: {error_details['error_message']}"
    ]
    
    # 添加字段级别的错误
    if error_details["field_errors"]:
        lines.append("   - 字段错误:")
        for field, errors in error_details["field_errors"].items():
            error_list = errors if isinstance(errors, list) else [errors]
            for err in error_list:
                lines.append(f"     • {field}: {err}")
    
    # 添加用户不存在的提示
    if error_details["is_user_not_found"]:
        lines.append("   - 原因: 用户ID在后端数据库中不存在")
        lines.append("   - 建议: 检查用户是否已注册，或使用有效的用户ID")
    
    return "\n".join(lines)

