    def _build_exercise_nutrition_params(self, user_profile: Dict, context: Dict) -> Dict[str, Any]:
        """构建运动营养优化器参数"""
        # 安全获取列表的第一个元素
        fitness_goals = user_profile.get("fitness_goals", ["增肌"])
        training_goal = fitness_goals[0] if isinstance(fitness_goals, list) and fitness_goals else "增肌"
        
        # 映射健身目标
        goal_mapping = {
            "增肌": "muscle_gain",
            "减脂": "weight_loss",
            "维持": "maintenance",
            "重组": "recomp",
            "力量": "muscle_gain",
            "耐力": "maintenance"
        }
        mapped_goal = goal_mapping.get(training_goal, "muscle_gain")
        
        # 映射训练类型
        training_type_mapping = {
            "增肌": "hypertrophy",
            "力量": "strength",
            "耐力": "endurance",
            "减脂": "hiit",
            "综合": "mixed"
        }
        training_type = training_type_mapping.get(training_goal, "hypertrophy")
        
        # 映射训练强度
        intensity = user_profile.get("training_intensity", "moderate")
        intensity_mapping = {
            "low": "low",
            "moderate": "moderate",
            "high": "high",
            "very_high": "very_high",
            "低": "low",
            "中": "moderate",
            "高": "high",
            "极高": "very_high"
        }
        mapped_intensity = intensity_mapping.get(intensity, "moderate")
        
        # 默认营养目标（基于体重计算）
        weight_kg = user_profile.get("weight_kg", 65)
        daily_protein_target = weight_kg * 1.8  # 1.8g/kg for muscle gain
        daily_carbs_target = weight_kg * 4  # 4g/kg for training
        
        return {
            "training_type": training_type,
            "training_duration_minutes": user_profile.get("session_duration", 60),
            "training_intensity": mapped_intensity,
            "training_time": "afternoon",  # 默认下午训练
            "weight_kg": weight_kg,
            "fitness_goal": mapped_goal,
            "daily_protein_target": daily_protein_target,
            "daily_carbs_target": daily_carbs_target
        }

    def _analyze_dependencies(self, tasks: List[DAGTask]) -> Dict[str, List[str]]:
        """分析任务依赖关系"""
        dependency_map = {}
        task_names = {task.tool_name for task in tasks}

        for task in tasks:
            # 过滤掉不在当前任务列表中的依赖
            valid_dependencies = [dep for dep in task.dependencies if dep in task_names]
            dependency_map[task.tool_name] = valid_dependencies

        return dependency_map

    def _topological_sort(
        self,
        tasks: List[DAGTask],
        dependencies: Dict[str, List[str]]
    ) -> List[ExecutionLevel]:
        """拓扑排序 - Kahn算法"""
        # 计算入度
        in_degree = {task.tool_name: 0 for task in tasks}
        for task in tasks:
            for dep in dependencies.get(task.tool_name, []):
                in_degree[task.tool_name] += 1

        # 初始化层级
        levels = []
        remaining_tasks = {task.tool_name: task for task in tasks}

        level_num = 0
        while remaining_tasks:
            # 找到当前入度为0的任务
            current_level_tasks = []
            for task_name, task in remaining_tasks.items():
                if in_degree[task_name] == 0:
                    current_level_tasks.append(task)

            if not current_level_tasks:
                # 存在循环依赖，选择一个任务继续
                current_level_tasks = [list(remaining_tasks.values())[0]]
                logger.warning(f"⚠️ 检测到循环依赖，选择任务继续: {current_level_tasks[0].tool_name}")

            # 按优先级排序
            current_level_tasks.sort(key=lambda t: t.priority.value)

            # 创建执行层级
            level = ExecutionLevel(
                level=level_num,
                tasks=current_level_tasks,
                estimated_duration=max(task.tool_metadata.execution_time for task in current_level_tasks),
                can_parallel=all(task.tool_metadata.parallel_safe for task in current_level_tasks)
            )

            levels.append(level)

            # 更新入度
            for task in current_level_tasks:
                remaining_tasks.pop(task.tool_name)
                task.level = level_num

                # 减少依赖任务的入度
                for other_task in remaining_tasks.values():
                    if task.tool_name in dependencies.get(other_task.tool_name, []):
                        in_degree[other_task.tool_name] -= 1

            level_num += 1

        return levels

    def _optimize_parallel_execution(
        self,
        levels: List[ExecutionLevel],
        cached_results: Dict[str, Any] = None
    ) -> List[ExecutionLevel]:
        """并行执行优化"""
        optimized_levels = []

        for level in levels:
            if not level.can_parallel:
                optimized_levels.append(level)
                continue

            # 分析并行安全组
            parallel_groups = self._group_parallel_safe_tasks(level.tasks, cached_results)
            level.parallel_groups = parallel_groups
            optimized_levels.append(level)

        return optimized_levels

    def _group_parallel_safe_tasks(
        self,
        tasks: List[DAGTask],
        cached_results: Dict[str, Any] = None
    ) -> List[List[DAGTask]]:
        """分组并行安全的任务"""
        groups = []
        used_tasks = set()

        # 优先处理缓存的任务
        cached_tasks = [task for task in tasks if task.tool_name in (cached_results or {})]
        if cached_tasks:
            groups.append(cached_tasks)
            used_tasks.update(task.tool_name for task in cached_tasks)

        # 按MCP服务器分组
        mcp_groups = defaultdict(list)
        for task in tasks:
            if task.tool_name not in used_tasks:
                mcp_groups[task.tool_metadata.mcp_server].append(task)

        # 为每个MCP服务器创建组
        for mcp_server, server_tasks in mcp_groups.items():
            if len(server_tasks) == 1:
                # 单个任务直接成组
                groups.append(server_tasks)
            else:
                # 多个任务按资源限制分组
                semaphore = self.resource_pools.get(mcp_server)
                if semaphore:
                    max_concurrent = semaphore._value
                    for i in range(0, len(server_tasks), max_concurrent):
                        group = server_tasks[i:i + max_concurrent]
                        groups.append(group)
                else:
                    # 没有资源限制，可以并行
                    groups.append(server_tasks)

        return groups

    async def _execute_dag_levels(
        self,
        execution_id: str,
        levels: List[ExecutionLevel],
        intent_result: Dict[str, Any],
        cached_results: Dict[str, Any] = None,
        session_context: Dict[str, Any] = None  # ✅ 新增：接收session_context
    ) -> DAGExecutionResult:
        """执行DAG层级"""
        start_time = time.time()
        all_results = (cached_results or {}).copy()
        
        # ✅ 新增：将session_context中的_context合并到all_results
        if session_context and "_context" in session_context:
            all_results["_context"] = session_context["_context"]
            logger.info(f"✅ 已将context传递到DAG执行环境")
        
        all_errors = {}
        tasks_completed = 0
        tasks_failed = 0

        logger.info(f"📊 执行DAG: {len(levels)}个层级")

        for level_index, level in enumerate(levels):
            logger.info(f"🔄 执行层级 {level_index + 1}/{len(levels)}: {len(level.tasks)}个任务")

            # 执行当前层级
            if level.parallel_groups:
                # 并行执行组
                for group_index, group in enumerate(level.parallel_groups):
                    logger.info(f"  📦 执行并行组 {group_index + 1}/{len(level.parallel_groups)}: {len(group)}个任务")

                    # 并行执行组内任务
                    group_results = await asyncio.gather(
                        *[self._execute_single_task(task, execution_id, all_results) for task in group],
                        return_exceptions=True
                    )

                    # 收集结果
                    for task, result in zip(group, group_results):
                        if isinstance(result, Exception):
                            all_errors[task.tool_name] = str(result)
                            tasks_failed += 1
                            logger.error(f"❌ 任务失败: {task.tool_name}, 错误: {result}")
                        else:
                            all_results[task.tool_name] = result
                            tasks_completed += 1
                            logger.info(f"✅ 任务完成: {task.tool_name}")

            else:
                # 串行执行
                for task in level.tasks:
                    result = await self._execute_single_task(task, execution_id, all_results)
                    if isinstance(result, Exception):
                        all_errors[task.tool_name] = str(result)
                        tasks_failed += 1
                    else:
                        all_results[task.tool_name] = result
                        tasks_completed += 1

        total_time = time.time() - start_time

        return DAGExecutionResult(
            execution_id=execution_id,
            intent_pattern=intent_result["intent"],
            success=tasks_failed == 0,
            total_time=total_time,
            levels_executed=len(levels),
            tasks_completed=tasks_completed,
            tasks_failed=tasks_failed,
            results=all_results,
            errors=all_errors,
            performance_metrics={
                "total_tasks": tasks_completed + tasks_failed,
                "success_rate": tasks_completed / max(tasks_completed + tasks_failed, 1),
                "average_task_time": total_time / max(tasks_completed + tasks_failed, 1)
            }
        )

    async def _execute_single_task(
        self,
        task: DAGTask,
        execution_id: str,
        previous_results: Dict[str, Any]
    ) -> Dict[str, Any]:
        """执行单个任务"""
        task.status = TaskStatus.RUNNING
        task.start_time = time.time()
        
        # 记录任务开始
        self.visualizer.log_tool_execution(
            tool_name=task.tool_name,
            status="running",
            message="开始执行"
        )

        try:
            # ⚠️ 关键修复：在执行前增强参数，从previous_results中提取依赖数据
            enhanced_params = self._enhance_task_params(task, previous_results)
            task.params = enhanced_params
            
            # 获取资源锁
            mcp_server = task.tool_metadata.mcp_server
            if mcp_server in self.resource_pools:
                async with self.resource_pools[mcp_server]:
                    result = await self._execute_task_with_retry(task, previous_results)
            else:
                result = await self._execute_task_with_retry(task, previous_results)
            
            # 记录任务完成
            duration = time.time() - task.start_time
            self.visualizer.log_tool_execution(
                tool_name=task.tool_name,
                status="completed",
                message="执行成功",
                duration=duration
            )
            
            return result

        except Exception as e:
            task.status = TaskStatus.FAILED
            task.error = str(e)
            
            # 记录任务失败
            duration = time.time() - task.start_time
            self.visualizer.log_tool_execution(
                tool_name=task.tool_name,
                status="failed",
                message="执行失败",
                duration=duration,
                error=str(e)
            )
            
            raise

    async def _execute_task_with_retry(
        self,
        task: DAGTask,
        previous_results: Dict[str, Any]
    ) -> Dict[str, Any]:
        """带重试的任务执行"""
        max_retries = task.tool_metadata.retry_count

        for attempt in range(max_retries + 1):
            try:
                # 检查缓存
                if task.tool_metadata.cacheable:
                    cached_result = await self._check_cache(task)
                    if cached_result:
                        task.status = TaskStatus.COMPLETED
                        task.end_time = time.time()
                        return cached_result

                # 执行任务
                result = await self._call_tool(task, previous_results)

                # 缓存结果
                if task.tool_metadata.cacheable:
                    await self._cache_result(task, result)

                task.status = TaskStatus.COMPLETED
                task.end_time = time.time()

                return result

            except Exception as e:
                if attempt < max_retries:
                    task.retry_count = attempt + 1
                    wait_time = 2 ** attempt  # 指数退避
                    logger.warning(f"⚠️ 任务 {task.tool_name} 执行失败，{wait_time}s后重试 (第{attempt + 1}次)")
                    await asyncio.sleep(wait_time)
                else:
                    raise

        raise RuntimeError(f"任务 {task.tool_name} 达到最大重试次数")

    async def _check_cache(self, task: DAGTask) -> Optional[Dict[str, Any]]:
        """检查缓存"""
        if self.cache_manager:
            try:
                cache_key = self._generate_cache_key(task)
                cached_result = await self.cache_manager.get_cache(cache_key)
                if cached_result:
                    return cached_result
            except Exception as e:
                logger.warning(f"缓存检查失败: {task.tool_name}, {e}")

        return None

    async def _cache_result(self, task: DAGTask, result: Dict[str, Any]):
        """缓存结果"""
        if self.cache_manager and task.tool_metadata.cacheable:
            try:
                cache_key = self._generate_cache_key(task)
                await self.cache_manager.set_cache(
                    cache_key,
                    result,
                    ttl=task.tool_metadata.cache_ttl
                )
            except Exception as e:
                logger.warning(f"缓存存储失败: {task.tool_name}, {e}")

    def _generate_cache_key(self, task: DAGTask) -> str:
        """生成缓存键"""
        key_data = {
            "tool_name": task.tool_name,
            "params": task.params,
            "user_id": task.params.get("user_id")
        }
        key_str = json.dumps(key_data, sort_keys=True)
        return hashlib.md5(key_str.encode()).hexdigest()

    async def _call_tool(
        self,
        task: DAGTask,
        previous_results: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        调用工具（增强版 v5.0 - 混合方案：优先使用context中的用户档案）
        
        优化策略：
        1. 如果工具是get_user_profile，优先从context获取（0延迟）
        2. 如果context中没有，调用用户档案MCP工具（stdio）
        3. 其他工具正常执行参数处理管道
        
        参数处理管道：提取 → 转换 → 验证 → 调用
        
        Args:
            task: DAG任务
            previous_results: 之前任务的结果
            
        Returns:
            Dict[str, Any]: 工具执行结果
        """
        tool_name = task.tool_name
        
        # ============================================================================
        # 🎯 混合方案优化：用户档案优先从context获取
        # ============================================================================
        if tool_name == "get_user_profile":
            # 检查context中是否有用户档案（步骤1预加载的结果）
            context = previous_results.get("_context", {})
            user_profile = context.get("user_profile")
            user_id = context.get("user_id")  # 从context获取user_id
            
            if user_profile:
                logger.info(f"✅ 从context获取用户档案（0延迟）")
                return {
                    "success": True,
                    "user_id": user_id,  # 添加user_id字段，供下游任务使用
                    "profile": user_profile,
                    "source": "context",
                    "cached": True
                }
            else:
                logger.info(f"⚠️ context中无用户档案，调用MCP工具")
                # 继续执行正常流程（调用MCP工具）
        
        # ============================================================================
        # 步骤1: 参数提取 - 从上游任务结果和配置中提取参数
        # ============================================================================
        logger.info(f"🔧 [参数处理管道] 开始处理工具: {tool_name}")
        logger.info(f"   📥 步骤1/4: 参数提取")
        
        try:
            # 获取工具配置
            tool_config = self.config_loader.get_tool_config(tool_name)
            
            if tool_config and tool_config.param_mappings:
                # 使用配置的映射规则提取参数
                from src.framework.orchestration.parameter_extractor import ParamMapping
                
                # 转换配置为ParamMapping对象
                param_mappings = [
                    ParamMapping(
                        source_task=mapping.source_task,
                        source_path=mapping.source_path,
                        target_param=mapping.target_param,
                        converter=mapping.converter,
                        default_value=mapping.default_value
                    )
                    for mapping in tool_config.param_mappings
                ]
                
                # 提取参数
                extracted_params = self.parameter_extractor.extract_from_upstream(
                    param_mappings=param_mappings,
                    upstream_results=previous_results,
                    context={"tool_name": tool_name}
                )
                
                # 合并提取的参数到任务参数
                task.params.update(extracted_params)
                
                logger.info(f"   ✅ 参数提取完成: 提取了 {len(extracted_params)} 个参数")
                logger.debug(f"      提取的参数: {list(extracted_params.keys())}")
            else:
                logger.debug(f"   ⚠️ 工具 {tool_name} 没有配置参数映射规则，跳过提取")
        
        except Exception as e:
            logger.error(f"   ❌ 参数提取失败: {e}", exc_info=True)
            # 继续执行，使用原有参数
        
        # ============================================================================
        # 步骤1.5: 确保user_id参数存在（关键修复）
        # ============================================================================
        if "user_id" not in task.params or not task.params["user_id"]:
            # 尝试从get_user_profile结果中获取
            if "get_user_profile" in previous_results:
                user_profile_result = previous_results["get_user_profile"]
                if isinstance(user_profile_result, dict):
                    user_id = user_profile_result.get("user_id")
                    if not user_id:
                        profile = user_profile_result.get("profile", {})
                        user_id = profile.get("user_id")
                    if user_id:
                        task.params["user_id"] = user_id
                        logger.info(f"   ✅ 从get_user_profile补充user_id: {user_id}")
            
            # 如果还是没有，尝试从_context中获取
            if not task.params.get("user_id"):
                context = previous_results.get("_context", {})
                user_id = context.get("user_id")
                if user_id:
                    task.params["user_id"] = user_id
                    logger.info(f"   ✅ 从_context补充user_id: {user_id}")
        
        # ============================================================================
        # 步骤1.6: 检查是否应该跳过工具（可选工具的依赖参数缺失时）
        # ============================================================================
        # 对于exercise_alternative_finder，如果original_exercise_id为空，跳过执行
        if tool_name == "exercise_alternative_finder":
            original_exercise_id = task.params.get("original_exercise_id")
            if not original_exercise_id or original_exercise_id == "":
                logger.warning(f"   ⚠️ 跳过 {tool_name}：无法从上游任务获取 original_exercise_id")
                logger.info(f"   💡 原因：intelligent_exercise_selector 可能没有返回有效的推荐结果")
                return {
                    "success": False,
                    "skipped": True,
                    "tool_name": tool_name,
                    "reason": "缺少必需参数 original_exercise_id（上游任务未返回有效推荐）",
                    "message": "动作替代查找器已跳过：没有可用的原始动作ID"
                }
        
        # 对于safe_exercise_modifier，如果exercise_id为空，跳过执行
        if tool_name == "safe_exercise_modifier":
            exercise_id = task.params.get("exercise_id")
            if not exercise_id or exercise_id == "":
                logger.warning(f"   ⚠️ 跳过 {tool_name}：无法从上游任务获取 exercise_id")
                return {
                    "success": False,
                    "skipped": True,
                    "tool_name": tool_name,
                    "reason": "缺少必需参数 exercise_id（上游任务未返回有效推荐）",
                    "message": "安全动作修改器已跳过：没有可用的动作ID"
                }
        
        # 对于intelligent_weight_calculator，如果exercise_id为空，跳过执行
        if tool_name == "intelligent_weight_calculator":
            exercise_id = task.params.get("exercise_id")
            if not exercise_id or exercise_id == "":
                logger.warning(f"   ⚠️ 跳过 {tool_name}：无法从上游任务获取 exercise_id")
                return {
                    "success": False,
                    "skipped": True,
                    "tool_name": tool_name,
                    "reason": "缺少必需参数 exercise_id（上游任务未返回有效推荐）",
                    "message": "智能负重计算器已跳过：没有可用的动作ID"
                }
        
        # 对于movement_pattern_balancer，如果current_program为空数组，跳过执行
        if tool_name == "movement_pattern_balancer":
            current_program = task.params.get("current_program", [])
            if not current_program or len(current_program) == 0:
                logger.warning(f"   ⚠️ 跳过 {tool_name}：current_program 为空")
                return {
                    "success": False,
                    "skipped": True,
                    "tool_name": tool_name,
                    "reason": "缺少必需参数 current_program（上游任务未返回有效推荐）",
                    "message": "动作模式平衡器已跳过：没有可用的训练计划"
                }
        
        # ============================================================================
        # 步骤2: 参数转换 - 中英文转换和类型转换
        # ============================================================================
        logger.info(f"   🔄 步骤2/4: 参数转换")
        
        try:
            # 记录转换前的参数
            params_before = task.params.copy()
            
            # 执行参数转换
            converted_params = self.parameter_converter.convert_params(
                params=task.params,
                tool_schema=None,  # 可选：传入工具的Pydantic Schema
                param_types=None
            )
            
            # 更新任务参数
            task.params = converted_params
            
            # 记录转换后的变化
            changed_params = {
                k: (params_before.get(k), v)
                for k, v in converted_params.items()
                if params_before.get(k) != v
            }
            
            if changed_params:
                logger.info(f"   ✅ 参数转换完成: 转换了 {len(changed_params)} 个参数")
                for param_name, (old_val, new_val) in changed_params.items():
                    logger.debug(f"      {param_name}: {old_val} → {new_val}")
            else:
                logger.debug(f"   ⚠️ 没有参数需要转换")
        
        except Exception as e:
            logger.error(f"   ❌ 参数转换失败: {e}", exc_info=True)
            # 继续执行，使用转换前的参数
        
        # ============================================================================
        # 步骤3: 参数验证 - 验证参数完整性和类型（严格模式）
        # ============================================================================
        logger.info(f"   🔍 步骤3/4: 参数验证")
        
        # 构建参数Schema（从配置中获取）
        param_schema = {}
        if tool_config:
            for param in tool_config.required_params:
                param_schema[param] = "Any"  # 简化处理，实际可以更详细
        
        # 执行参数验证
        validation_result = self.parameter_validator.validate_params(
            params=task.params,
            tool_name=tool_name,
            tool_schema=None,  # 可选：传入工具的Pydantic Schema
            param_schema=param_schema if param_schema else None
        )
        
        if validation_result.is_valid:
            logger.info(f"   ✅ 参数验证通过")
        else:
            # 参数验证失败 - 严格模式：立即失败
            logger.error(f"   ❌ 参数验证失败: {tool_name}")
            for error in validation_result.errors:
                logger.error(f"      - {error}")
            
            # 获取验证配置
            validation_config = self.config_loader.get_validation_config()
            strict_mode = validation_config.get('strict_mode', True)
            
            if strict_mode:
                # 严格模式：快速失败，避免浪费时间重试
                error_msg = f"参数验证失败: {tool_name}\n错误详情:\n"
                for error in validation_result.errors:
                    error_msg += f"  - {error}\n"
                
                logger.error(f"   🚫 严格模式已启用，终止执行")
                raise ValueError(error_msg)
            else:
                # 宽松模式：记录警告但继续执行
                logger.warning(f"   ⚠️ 宽松模式：忽略验证错误，继续执行")
        
        # ============================================================================
        # 步骤4: 工具调用 - 调用MCP工具
        # ============================================================================
        logger.info(f"   🚀 步骤4/4: 工具调用")
        logger.info(f"   📋 最终参数: {list(task.params.keys())}")
        
        if self.mcp_orchestrator:
            # 使用MCP工具管理器实际调用MCP工具
            try:
                logger.debug(f"      - 服务器: {task.tool_metadata.mcp_server}")
                logger.debug(f"      - 参数详情: {task.params}")
                
                # 调用MCPToolManager的call_tool方法
                mcp_result = await self.mcp_orchestrator.call_tool(
                    task_name=task.tool_name,
                    parameters=task.params,
                    context={"previous_results": previous_results}
                )
                
                # 解析MCP工具返回的结果
                if hasattr(mcp_result, 'success'):
                    # MCPToolCallResult对象
                    if mcp_result.success:
                        logger.info(f"   ✅ MCP工具调用成功: {task.tool_name} (耗时: {mcp_result.execution_time_ms:.2f}ms)")
                        return mcp_result.data or {}
                    else:
                        # 调用失败但有降级结果
                        if mcp_result.fallback_used:
                            logger.warning(f"   ⚠️ MCP工具调用失败，使用降级结果: {task.tool_name}")
                            logger.warning(f"      - 错误: {mcp_result.error}")
                            return mcp_result.data or {}
                        else:
                            # 调用失败且无降级
                            logger.error(f"   ❌ MCP工具调用失败: {task.tool_name}")
                            logger.error(f"      - 错误: {mcp_result.error}")
                            raise Exception(f"MCP工具调用失败: {mcp_result.error}")
                else:
                    # 字典格式的结果
                    logger.info(f"   ✅ MCP工具调用成功: {task.tool_name}")
                    return mcp_result
                    
            except Exception as e:
                logger.error(f"   ❌ MCP工具调用异常: {task.tool_name}, 错误: {e}", exc_info=True)
                # 提供降级方案
                return {
                    "success": False,
                    "error": str(e),
                    "tool_name": task.tool_name,
                    "fallback": True,
                    "message": f"工具 {task.tool_name} 暂时不可用"
                }
        else:
            # 没有MCP编排器，使用本地实现
            logger.warning(f"   ⚠️ 没有MCP编排器，使用本地实现: {task.tool_name}")
            return await self._call_local_tool(task.tool_name, task.params)

    async def _call_local_tool(self, tool_name: str, params: Dict[str, Any]) -> Dict[str, Any]:
        """本地工具调用"""
        # 这里实现本地工具的调用逻辑
        # 暂时返回模拟结果
        return {
            "tool": tool_name,
            "status": "success",
            "data": params,
            "timestamp": time.time()
        }

    def _extract_actual_result(self, result: Dict[str, Any]) -> Dict[str, Any]:
        """
        从工具结果中提取实际数据
        
        MCPToolCallResult返回的格式是 {"success": True, "data": {...}, ...}
        实际的工具结果可能在data字段中，需要解包
        
        Args:
            result: 工具返回的原始结果
            
        Returns:
            Dict[str, Any]: 实际的工具结果数据
        """
        if not isinstance(result, dict):
            return result
        
        # 如果有data字段，尝试解包
        if "data" in result:
            actual_result = result.get("data", result)
            # 如果data字段本身也是一个包含data的字典，继续解包
            if isinstance(actual_result, dict) and "data" in actual_result:
                actual_result = actual_result.get("data", actual_result)
            return actual_result
        
        return result

    def _enhance_task_params(
        self,
        task: DAGTask,
        previous_results: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        增强任务参数，从previous_results中提取依赖数据
        
        Args:
            task: DAG任务
            previous_results: 之前任务的结果
            
        Returns:
            Dict[str, Any]: 增强后的参数
        """
        enhanced_params = task.params.copy()
        
        # 根据工具类型自动填充缺失的必需参数
        tool_name = task.tool_name
        
        # 0. 处理所有工具都需要的user_id参数
        if "user_id" not in enhanced_params or not enhanced_params["user_id"]:
            # 尝试从get_user_profile结果中获取user_id
            if "get_user_profile" in previous_results:
                user_profile_result = previous_results["get_user_profile"]
                if isinstance(user_profile_result, dict):
                    # 尝试从profile中获取
                    profile = user_profile_result.get("profile", {})
                    user_id = profile.get("user_id") or user_profile_result.get("user_id")
                    if user_id:
                        enhanced_params["user_id"] = user_id
                        logger.info(f"   ✅ 自动填充参数 user_id: {user_id}")
            
            # 如果还是没有，尝试从_context中获取
            if not enhanced_params.get("user_id"):
                context = previous_results.get("_context", {})
                user_id = context.get("user_id")
                if user_id:
                    enhanced_params["user_id"] = user_id
                    logger.info(f"   ✅ 从_context自动填充参数 user_id: {user_id}")
        
        # 1. 处理需要exercises参数的工具
        if tool_name in ["injury_risk_assessor", 
                         "muscle_group_volume_calculator", "movement_pattern_balancer"]:
            if "exercises" not in enhanced_params or not enhanced_params["exercises"]:
                # 尝试从semantic_search或intelligent_exercise_selector结果中获取
                exercises = []
                
                # 优先从intelligent_exercise_selector获取
                if "intelligent_exercise_selector" in previous_results:
                    selector_result = previous_results["intelligent_exercise_selector"]
                    if isinstance(selector_result, dict):
                        # 🔧 使用辅助函数提取实际结果
                        actual_result = self._extract_actual_result(selector_result)
                        exercises = actual_result.get("selected_exercises", [])
                        if not exercises:
                            exercises = actual_result.get("exercises", [])
                        if not exercises:
                            # 尝试从recommendations中获取
                            recommendations = actual_result.get("recommendations", [])
                            if recommendations:
                                exercises = recommendations
                
                # 如果没有，从semantic_search获取
                if not exercises and "semantic_search" in previous_results:
                    search_result = previous_results["semantic_search"]
                    if isinstance(search_result, dict):
                        # 🔧 使用辅助函数提取实际结果
                        actual_result = self._extract_actual_result(search_result)
                        exercises = actual_result.get("results", [])
                
                # 如果还是没有，使用空列表（让工具自己处理）
                enhanced_params["exercises"] = exercises
                logger.info(f"   ✅ 自动填充参数 exercises: {len(exercises)}个动作")
        
        # 1.5. 处理contraindications_checker的特殊参数需求（需要exercise_ids而不是exercises）
        if tool_name == "contraindications_checker":
            if "exercise_ids" not in enhanced_params or not enhanced_params["exercise_ids"]:
                exercise_ids = []
                
                # 从intelligent_exercise_selector结果中提取exercise_ids
                if "intelligent_exercise_selector" in previous_results:
                    selector_result = previous_results["intelligent_exercise_selector"]
                    if isinstance(selector_result, dict):
                        # 🔧 使用辅助函数提取实际结果
                        actual_result = self._extract_actual_result(selector_result)
                        # 尝试从recommendations中提取
                        recommendations = actual_result.get("recommendations", [])
                        if recommendations:
                            exercise_ids = [
                                ex.get("exercise_id") or ex.get("id")
                                for ex in recommendations
                                if isinstance(ex, dict) and (ex.get("exercise_id") or ex.get("id"))
                            ]
                        
                        # 如果没有，尝试从selected_exercises中提取
                        if not exercise_ids:
                            exercises = selector_result.get("selected_exercises", [])
                            if exercises:
                                exercise_ids = [
                                    ex.get("exercise_id") or ex.get("id")
                                    for ex in exercises
                                    if isinstance(ex, dict) and (ex.get("exercise_id") or ex.get("id"))
                                ]
                
                # 如果还是没有，使用空列表
                enhanced_params["exercise_ids"] = exercise_ids
                logger.info(f"   ✅ 自动填充参数 exercise_ids: {len(exercise_ids)}个ID")
        
        # 2. 处理需要exercise_id参数的工具
        if tool_name in ["exercise_alternative_finder", "intelligent_weight_calculator"]:
            # exercise_alternative_finder需要original_exercise_id，其他工具需要exercise_id
            param_name = "original_exercise_id" if tool_name == "exercise_alternative_finder" else "exercise_id"
            
            if param_name not in enhanced_params or not enhanced_params.get(param_name):
                # 尝试从intelligent_exercise_selector结果中获取第一个动作
                exercise_id = None
                if "intelligent_exercise_selector" in previous_results:
                    selector_result = previous_results["intelligent_exercise_selector"]
                    
                    if isinstance(selector_result, dict):
                        # 🔧 关键修复：处理嵌套的data字段
                        # MCPToolCallResult返回的格式是 {"success": True, "data": {...}, ...}
                        # 实际的工具结果可能在data字段中
                        actual_result = selector_result.get("data", selector_result)
                        if isinstance(actual_result, dict) and "data" in actual_result:
                            # 如果data字段本身也是一个包含data的字典，继续解包
                            actual_result = actual_result.get("data", actual_result)
                        
                        # 优先从recommendations中提取（这是标准返回字段）
                        recommendations = actual_result.get("recommendations", [])
                        
                        if recommendations and len(recommendations) > 0:
                            first_exercise = recommendations[0]
                            if isinstance(first_exercise, dict):
                                exercise_id = first_exercise.get("exercise_id") or first_exercise.get("id")
                                logger.info(f"   ✅ 从recommendations[0]提取{param_name}: {exercise_id}")
                        else:
                            logger.warning(f"   ⚠️ recommendations为空或不存在，尝试其他字段")
                        
                        # 如果没有，尝试从selected_exercises中提取
                        if not exercise_id:
                            exercises = actual_result.get("selected_exercises", [])
                            if exercises and len(exercises) > 0:
                                first_exercise = exercises[0]
                                if isinstance(first_exercise, dict):
                                    exercise_id = first_exercise.get("exercise_id") or first_exercise.get("id")
                                    logger.info(f"   ✅ 从selected_exercises[0]提取{param_name}: {exercise_id}")
                
                if exercise_id:
                    enhanced_params[param_name] = exercise_id
                    logger.info(f"   ✅ 自动填充参数 {param_name}: {exercise_id}")
                else:
                    # 🔧 关键修复：设置空字符串，触发步骤1.6的跳过逻辑
                    enhanced_params[param_name] = ""
                    logger.warning(f"   ⚠️ 无法填充参数 {param_name}，设置为空字符串（将触发跳过逻辑）")
        
        # 2.5. 处理safe_exercise_modifier的特殊参数需求
        if tool_name == "safe_exercise_modifier":
            # 需要exercise_id参数（动作ID）
            if "exercise_id" not in enhanced_params or not enhanced_params["exercise_id"]:
                exercise_id = None
                
                # 尝试从intelligent_exercise_selector结果中获取第一个动作ID
                if "intelligent_exercise_selector" in previous_results:
                    selector_result = previous_results["intelligent_exercise_selector"]
                    if isinstance(selector_result, dict):
                        # 🔧 关键修复：处理嵌套的data字段
                        actual_result = selector_result.get("data", selector_result)
                        if isinstance(actual_result, dict) and "data" in actual_result:
                            actual_result = actual_result.get("data", actual_result)
                        
                        # 尝试从recommendations中获取
                        recommendations = actual_result.get("recommendations", [])
                        if recommendations and len(recommendations) > 0:
                            first_exercise = recommendations[0]
                            if isinstance(first_exercise, dict):
                                exercise_id = first_exercise.get("exercise_id") or first_exercise.get("id")
                        
                        # 如果没有，尝试从selected_exercises中获取
                        if not exercise_id:
                            exercises = actual_result.get("selected_exercises", [])
                            if exercises and len(exercises) > 0:
                                first_exercise = exercises[0]
                                if isinstance(first_exercise, dict):
                                    exercise_id = first_exercise.get("exercise_id") or first_exercise.get("id")
                
                # 如果没有，从injury_risk_assessor结果获取
                if not exercise_id and "injury_risk_assessor" in previous_results:
                    risk_result = previous_results["injury_risk_assessor"]
                    if isinstance(risk_result, dict):
                        # 🔧 关键修复：处理嵌套的data字段
                        actual_risk_result = risk_result.get("data", risk_result)
                        if isinstance(actual_risk_result, dict) and "data" in actual_risk_result:
                            actual_risk_result = actual_risk_result.get("data", actual_risk_result)
                        
                        exercise_profiles = actual_risk_result.get("exercise_risk_profiles", [])
                        if exercise_profiles and len(exercise_profiles) > 0:
                            exercise_id = exercise_profiles[0].get("exercise_id")
                
                if exercise_id:
                    enhanced_params["exercise_id"] = exercise_id
                    logger.info(f"   ✅ 自动填充参数 exercise_id: {exercise_id}")
                else:
                    # 🔧 关键修复：设置空字符串，触发步骤1.6的跳过逻辑
                    enhanced_params["exercise_id"] = ""
                    logger.warning(f"   ⚠️ 无法填充参数 exercise_id，设置为空字符串（将触发跳过逻辑）")
            
            # 需要modification_purpose参数
            if "modification_purpose" not in enhanced_params or not enhanced_params["modification_purpose"]:
                # 根据用户档案设置默认值
                user_profile = enhanced_params.get("user_profile", {})
                fitness_level = user_profile.get("fitness_level", "beginner")
                
                if fitness_level == "beginner":
                    enhanced_params["modification_purpose"] = "beginner_friendly"
                else:
                    enhanced_params["modification_purpose"] = "injury_prevention"
                logger.info(f"   ✅ 自动填充参数 modification_purpose: {enhanced_params['modification_purpose']}")
            
            # 需要user_injuries参数
            if "user_injuries" not in enhanced_params:
                user_profile = enhanced_params.get("user_profile", {})
                if not user_profile and "get_user_profile" in previous_results:
                    user_profile_result = previous_results["get_user_profile"]
                    if isinstance(user_profile_result, dict):
                        user_profile = user_profile_result.get("profile", {})
                
                injury_history = user_profile.get("injury_history", [])
                enhanced_params["user_injuries"] = injury_history
                logger.info(f"   ✅ 自动填充参数 user_injuries: {len(injury_history)}条记录")
        
        # 3. 处理需要training_plan参数的工具
        if tool_name in ["exercise_nutrition_optimization", "nutrition_timing"]:
            if "training_plan" not in enhanced_params or not enhanced_params["training_plan"]:
                # 尝试从professional_program_designer结果中获取
                if "professional_program_designer" in previous_results:
                    program_result = previous_results["professional_program_designer"]
                    if isinstance(program_result, dict):
                        # 🔧 使用辅助函数提取实际结果
                        actual_result = self._extract_actual_result(program_result)
                        training_plan = actual_result.get("program") or actual_result.get("training_plan")
                        if training_plan:
                            enhanced_params["training_plan"] = training_plan
                            logger.info(f"   ✅ 自动填充参数 training_plan")
        
        # 4. 处理需要nutrition_goals参数的工具
        if tool_name in ["meal_plan_designer", "exercise_nutrition_optimization"]:
            if "nutrition_goals" not in enhanced_params or not enhanced_params["nutrition_goals"]:
                # 尝试从tdee_calculator结果中获取
                nutrition_goals = {}
                if "tdee_calculator" in previous_results:
                    tdee_result = previous_results["tdee_calculator"]
                    if isinstance(tdee_result, dict):
                        # 🔧 使用辅助函数提取实际结果
                        actual_result = self._extract_actual_result(tdee_result)
                        nutrition_goals = {
                            "tdee": actual_result.get("tdee"),
                            "bmr": actual_result.get("bmr"),
                            "calorie_target": actual_result.get("calorie_target")
                        }
                
                if nutrition_goals:
                    enhanced_params["nutrition_goals"] = nutrition_goals
                    logger.info(f"   ✅ 自动填充参数 nutrition_goals")
        
        # 5. 处理需要food_log/meals参数的工具
        if tool_name in ["nutrition_intake_analyzer"]:
            if "food_log" not in enhanced_params or not enhanced_params["food_log"]:
                # 使用空列表作为默认值
                enhanced_params["food_log"] = []
                logger.info(f"   ✅ 自动填充参数 food_log: 空列表")
        
        return enhanced_params
    
    def _generate_execution_id(self) -> str:
        """生成执行ID"""
        import uuid
        return f"dag_{int(time.time())}_{uuid.uuid4().hex[:8]}"

    def get_available_templates(self) -> List[Dict[str, Any]]:
        """获取所有可用的DAG模板"""
        templates = []
        for template in self.template_manager.get_all_templates():
            templates.append({
                "template_id": template.template_id,
                "name": template.name,
                "description": template.description,
                "category": template.category.value,
                "complexity_level": template.complexity_level,
                "estimated_duration": template.estimated_duration_seconds,
                "required_tools_count": len(template.required_tools),
                "optional_tools_count": len(template.optional_tools),
                "applicable_intents": template.applicable_intents
            })
        return templates

    def get_template_info(self, template_id: str) -> Optional[Dict[str, Any]]:
        """获取模板详细信息"""
        template = self.template_manager.get_template(template_id)
        if not template:
            return None
        
        return {
            "template_id": template.template_id,
            "name": template.name,
            "description": template.description,
            "category": template.category.value,
            "complexity_level": template.complexity_level,
            "estimated_duration": template.estimated_duration_seconds,
            "required_tools": template.required_tools,
            "optional_tools": template.optional_tools,
            "tool_dependencies": template.tool_dependencies,
            "parallel_groups": template.parallel_groups,
            "expected_output": template.expected_output,
            "safety_constraints": template.safety_constraints,
            "applicable_intents": template.applicable_intents,
            "usage_count": self.performance_stats["template_usage"].get(template_id, 0)
        }

    def get_performance_statistics(self) -> Dict[str, Any]:
        """获取性能统计"""
        return {
            **self.performance_stats,
            "execution_history": self.execution_history[-10:],  # 最近10次执行
            "tool_usage_stats": self._calculate_tool_usage_stats(),
            "template_statistics": dict(self.performance_stats["template_usage"]),
            "available_templates": len(self.template_manager.get_all_templates())
        }

    def _calculate_tool_usage_stats(self) -> Dict[str, int]:
        """计算工具使用统计"""
        stats = defaultdict(int)
        for execution in self.execution_history:
            # 这里可以从execution中提取工具使用信息
            # 暂时返回空统计
            pass
        return dict(stats)
    
    def get_execution_logs(
        self,
        tool_name: Optional[str] = None,
        status: Optional[str] = None,
        limit: Optional[int] = None
    ) -> List[Any]:
        """
        获取执行日志
        
        Args:
            tool_name: 过滤工具名称
            status: 过滤状态
            limit: 限制数量
            
        Returns:
            List: 日志列表
        """
        return self.visualizer.get_execution_logs(tool_name, status, limit)
    
    def generate_execution_summary(self) -> str:
        """生成执行摘要"""
        return self.visualizer.generate_execution_summary()
    
    def export_execution_logs(self, filepath: str):
        """
        导出执行日志到文件
        
        Args:
            filepath: 文件路径
        """
        self.visualizer.export_logs_to_file(filepath)
