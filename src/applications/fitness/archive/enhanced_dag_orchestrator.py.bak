    def _build_tdee_params(self, user_profile: Dict, context: Dict) -> Dict[str, Any]:
        """构建TDEE计算参数"""
        # 安全获取列表的第一个元素
        fitness_goals = user_profile.get("fitness_goals", ["增肌"])
        training_goal = fitness_goals[0] if isinstance(fitness_goals, list) and fitness_goals else "增肌"
        
        # 映射健身目标到fitness_goal枚举值
        goal_mapping = {
            "增肌": "muscle_gain",
            "减脂": "weight_loss",
            "维持": "maintenance",
            "重组": "recomp",
            "力量": "muscle_gain",
            "耐力": "maintenance"
        }
        mapped_goal = goal_mapping.get(training_goal, "muscle_gain")
        
        # 映射活动水平
        activity_level = user_profile.get("activity_level", "moderate")
        activity_mapping = {
            "sedentary": "sedentary",
            "light": "lightly_active",
            "moderate": "moderately_active",
            "active": "very_active",
            "very_active": "extremely_active",
            "久坐": "sedentary",
            "轻度活动": "lightly_active",
            "中度活动": "moderately_active",
            "高度活动": "very_active",
            "极高活动": "extremely_active"
        }
        mapped_activity = activity_mapping.get(activity_level, "moderately_active")
        
        # 映射训练强度
        training_intensity = user_profile.get("training_intensity", "moderate")
        intensity_mapping = {
            "low": "low",
            "moderate": "moderate",
            "high": "high",
            "低": "low",
            "中": "moderate",
            "高": "high"
        }
        mapped_intensity = intensity_mapping.get(training_intensity, "moderate")
        
        return {
            "training_frequency_per_week": user_profile.get("preferred_training_days", 3),
            "training_intensity": mapped_intensity,
            "daily_activity_level": mapped_activity,
            "fitness_goal": mapped_goal
        }

    def _build_meal_plan_params(self, user_profile: Dict, context: Dict) -> Dict[str, Any]:
        """构建膳食计划参数"""
        # 安全获取列表的第一个元素
        fitness_goals = user_profile.get("fitness_goals", ["增肌"])
        training_goal = fitness_goals[0] if isinstance(fitness_goals, list) and fitness_goals else "增肌"
        
        # 映射健身目标
        goal_mapping = {
            "增肌": "muscle_gain",
            "减脂": "weight_loss",
            "维持": "maintenance",
            "重组": "recomp"
        }
        mapped_goal = goal_mapping.get(training_goal, "muscle_gain")
        
        # 映射饮食偏好
        dietary_prefs = user_profile.get("dietary_preferences", [])
        dietary_pref = dietary_prefs[0] if isinstance(dietary_prefs, list) and dietary_prefs else "balanced"
        pref_mapping = {
            "均衡": "balanced",
            "高蛋白": "high_protein",
            "低碳水": "low_carb",
            "生酮": "keto",
            "素食": "vegetarian",
            "纯素": "vegan"
        }
        mapped_pref = pref_mapping.get(dietary_pref, dietary_pref if dietary_pref in ["balanced", "high_protein", "low_carb", "keto", "vegetarian", "vegan"] else "balanced")
        
        # 默认营养目标（基于2000卡路里）
        target_calories = user_profile.get("target_calories", 2000)
        
        return {
            "target_calories": target_calories,
            "target_protein_grams": user_profile.get("target_protein_grams", target_calories * 0.3 / 4),  # 30%蛋白质
            "target_carbs_grams": user_profile.get("target_carbs_grams", target_calories * 0.4 / 4),  # 40%碳水
            "target_fat_grams": user_profile.get("target_fat_grams", target_calories * 0.3 / 9),  # 30%脂肪
            "dietary_preference": mapped_pref,
            "meals_per_day": user_profile.get("meals_per_day", 4),
            "training_days_per_week": user_profile.get("preferred_training_days", 3),
            "fitness_goal": mapped_goal
        }

    def _build_volume_calculator_params(self, user_profile: Dict, context: Dict) -> Dict[str, Any]:
        """构建训练量计算器参数"""
        # 安全获取列表的第一个元素
        target_muscles = user_profile.get("target_muscle_groups", ["胸部"])
        muscle_group = target_muscles[0] if isinstance(target_muscles, list) and target_muscles else "胸部"
        
        fitness_goals = user_profile.get("fitness_goals", ["增肌"])
        training_goal = fitness_goals[0] if isinstance(fitness_goals, list) and fitness_goals else "增肌"
        
        # 映射训练目标到枚举值
        goal_mapping = {
            "增肌": "hypertrophy",
            "力量": "strength",
            "耐力": "endurance",
            "减脂": "general",
            "综合": "general"
        }
        mapped_goal = goal_mapping.get(training_goal, "hypertrophy")
        
        # 映射恢复能力（从数值转换为字符串）
        recovery_value = user_profile.get("recovery_capacity", 0.7)
        if isinstance(recovery_value, (int, float)):
            if recovery_value < 0.4:
                recovery_capacity = "low"
            elif recovery_value < 0.7:
                recovery_capacity = "moderate"
            else:
                recovery_capacity = "high"
        else:
            recovery_capacity = recovery_value if recovery_value in ["low", "moderate", "high"] else "moderate"
        
        return {
            "muscle_group": muscle_group,
            "training_goal": mapped_goal,
            "training_frequency_per_week": user_profile.get("preferred_training_days", 3),
            "recovery_capacity": recovery_capacity
        }

