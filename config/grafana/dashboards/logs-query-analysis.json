{
  "title": "日志查询和分析",
  "tags": ["daml-rag", "logs", "loki", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "实时日志流",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=~\"daml-rag.*\"}",
          "refId": "A",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 2,
      "title": "错误日志",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 10 },
      "targets": [
        {
          "expr": "{job=~\"daml-rag.*\"} |~ \"ERROR|CRITICAL\"",
          "refId": "A",
          "maxLines": 50
        }
      ]
    },
    {
      "id": 3,
      "title": "日志级别统计",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({job=~\"daml-rag.*\"} | pattern \"<_> - <_> - <level> - <_>\" [1m]))",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "日志总量",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"daml-rag.*\"}[$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "错误数量",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": { "x": 6, "y": 20, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=~\"daml-rag.*\"} |~ \"ERROR\" [$__range]))",
          "refId": "A"
        }
      ]
    }
  ],
  "uid": "logs-query-analysis"
}
