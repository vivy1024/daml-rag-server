{
  "title": "工作流性能优化监控",
  "tags": ["daml-rag", "workflow", "performance", "optimization"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "工作流总耗时 (P50, P95, P99)",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(workflow_total_duration_seconds_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_total_duration_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(workflow_total_duration_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "s", "label": "Duration"}],
      "alert": {
        "conditions": [
          {
            "evaluator": {"params": [30], "type": "gt"},
            "operator": {"type": "and"},
            "query": {"params": ["B", "5m", "now"]},
            "reducer": {"params": [], "type": "avg"},
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "1m",
        "handler": 1,
        "name": "工作流总耗时超过30秒",
        "noDataState": "no_data",
        "notifications": []
      }
    },
    {
      "id": 2,
      "title": "工作流成功率",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "workflow_success_rate",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "red"},
              {"value": 0.9, "color": "yellow"},
              {"value": 0.95, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "并发请求数",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "workflow_concurrent_requests",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 80, "color": "yellow"},
              {"value": 100, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "性能瓶颈总数",
      "type": "stat",
      "gridPos": {"x": 12, "y": 4, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "workflow_bottleneck_total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 10, "color": "yellow"},
              {"value": 50, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "TTFB (首字节响应时间)",
      "type": "stat",
      "gridPos": {"x": 18, "y": 4, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤1-用户档案加载\"}[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 5, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "步骤级别性能 (P95)",
      "type": "graph",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 10},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤1-用户档案加载\"}[5m]))",
          "legendFormat": "步骤1-用户档案加载",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤3-会员权限检查\"}[5m]))",
          "legendFormat": "步骤3-会员权限检查",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤4-BGE复杂度分类\"}[5m]))",
          "legendFormat": "步骤4-BGE复杂度分类",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤6.5-LLM选择DAG方案\"}[5m]))",
          "legendFormat": "步骤6.5-LLM选择DAG方案",
          "refId": "D"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤7-DAG编排执行\"}[5m]))",
          "legendFormat": "步骤7-DAG编排执行",
          "refId": "E"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤8-三层检索\"}[5m]))",
          "legendFormat": "步骤8-三层检索",
          "refId": "F"
        },
        {
          "expr": "histogram_quantile(0.95, rate(workflow_step_duration_seconds_bucket{step=\"步骤10-LLM深度分析\"}[5m]))",
          "legendFormat": "步骤10-LLM深度分析",
          "refId": "G"
        }
      ],
      "yaxes": [{"format": "s", "label": "Duration"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true, "max": true, "min": true}
    },
    {
      "id": 7,
      "title": "缓存命中率 (L1/L2/L3)",
      "type": "graph",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(cache_hits_total{level=\"L1\"}[5m]) / (rate(cache_hits_total{level=\"L1\"}[5m]) + rate(cache_misses_total{level=\"L1\"}[5m]))",
          "legendFormat": "L1 内存缓存",
          "refId": "A"
        },
        {
          "expr": "rate(cache_hits_total{level=\"L2\"}[5m]) / (rate(cache_hits_total{level=\"L2\"}[5m]) + rate(cache_misses_total{level=\"L2\"}[5m]))",
          "legendFormat": "L2 Redis缓存",
          "refId": "B"
        },
        {
          "expr": "rate(cache_hits_total{level=\"L3\"}[5m]) / (rate(cache_hits_total{level=\"L3\"}[5m]) + rate(cache_misses_total{level=\"L3\"}[5m]))",
          "legendFormat": "L3 数据库",
          "refId": "C"
        }
      ],
      "yaxes": [
        {
          "format": "percentunit",
          "label": "Hit Rate",
          "max": 1,
          "min": 0
        }
      ],
      "legend": {"show": true, "alignAsTable": true, "avg": true}
    },
    {
      "id": 8,
      "title": "缓存操作统计",
      "type": "graph",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(cache_hits_total[5m])",
          "legendFormat": "缓存命中 - {{cache_type}}",
          "refId": "A"
        },
        {
          "expr": "rate(cache_misses_total[5m])",
          "legendFormat": "缓存未命中 - {{cache_type}}",
          "refId": "B"
        },
        {
          "expr": "rate(cache_evictions_total[5m])",
          "legendFormat": "缓存淘汰 - {{cache_type}}",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "ops", "label": "Operations/sec"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true}
    },
    {
      "id": 9,
      "title": "连接池使用率 - MySQL",
      "type": "graph",
      "gridPos": {"x": 0, "y": 26, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "connection_pool_active{pool=\"mysql\"}",
          "legendFormat": "活跃连接",
          "refId": "A"
        },
        {
          "expr": "connection_pool_idle{pool=\"mysql\"}",
          "legendFormat": "空闲连接",
          "refId": "B"
        },
        {
          "expr": "connection_pool_max_size{pool=\"mysql\"}",
          "legendFormat": "最大连接数",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "short", "label": "Connections"}],
      "legend": {"show": true, "alignAsTable": true, "current": true}
    },
    {
      "id": 10,
      "title": "连接池使用率 - Neo4j",
      "type": "graph",
      "gridPos": {"x": 8, "y": 26, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "connection_pool_active{pool=\"neo4j\"}",
          "legendFormat": "活跃连接",
          "refId": "A"
        },
        {
          "expr": "connection_pool_idle{pool=\"neo4j\"}",
          "legendFormat": "空闲连接",
          "refId": "B"
        },
        {
          "expr": "connection_pool_max_size{pool=\"neo4j\"}",
          "legendFormat": "最大连接数",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "short", "label": "Connections"}],
      "legend": {"show": true, "alignAsTable": true, "current": true}
    },
    {
      "id": 11,
      "title": "连接池使用率 - HTTP",
      "type": "graph",
      "gridPos": {"x": 16, "y": 26, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "connection_pool_active{pool=\"http\"}",
          "legendFormat": "活跃连接",
          "refId": "A"
        },
        {
          "expr": "connection_pool_idle{pool=\"http\"}",
          "legendFormat": "空闲连接",
          "refId": "B"
        },
        {
          "expr": "connection_pool_max_size{pool=\"http\"}",
          "legendFormat": "最大连接数",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "short", "label": "Connections"}],
      "legend": {"show": true, "alignAsTable": true, "current": true}
    },
    {
      "id": 12,
      "title": "连接池等待时间",
      "type": "graph",
      "gridPos": {"x": 0, "y": 34, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(connection_pool_wait_time_seconds_bucket{pool=\"mysql\"}[5m]))",
          "legendFormat": "MySQL P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(connection_pool_wait_time_seconds_bucket{pool=\"neo4j\"}[5m]))",
          "legendFormat": "Neo4j P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(connection_pool_wait_time_seconds_bucket{pool=\"http\"}[5m]))",
          "legendFormat": "HTTP P95",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "s", "label": "Wait Time"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true, "max": true}
    },
    {
      "id": 13,
      "title": "连接池健康检查失败率",
      "type": "graph",
      "gridPos": {"x": 12, "y": 34, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(connection_pool_health_check_failures_total{pool=\"mysql\"}[5m])",
          "legendFormat": "MySQL",
          "refId": "A"
        },
        {
          "expr": "rate(connection_pool_health_check_failures_total{pool=\"neo4j\"}[5m])",
          "legendFormat": "Neo4j",
          "refId": "B"
        },
        {
          "expr": "rate(connection_pool_health_check_failures_total{pool=\"http\"}[5m])",
          "legendFormat": "HTTP",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "ops", "label": "Failures/sec"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true}
    },
    {
      "id": 14,
      "title": "LLM调用成功率",
      "type": "graph",
      "gridPos": {"x": 0, "y": 42, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(llm_call_success_total{backend=\"deepseek\"}[5m]) / (rate(llm_call_success_total{backend=\"deepseek\"}[5m]) + rate(llm_call_failure_total{backend=\"deepseek\"}[5m]))",
          "legendFormat": "DeepSeek",
          "refId": "A"
        },
        {
          "expr": "rate(llm_call_success_total{backend=\"ollama\"}[5m]) / (rate(llm_call_success_total{backend=\"ollama\"}[5m]) + rate(llm_call_failure_total{backend=\"ollama\"}[5m]))",
          "legendFormat": "Ollama",
          "refId": "B"
        },
        {
          "expr": "rate(llm_call_success_total{backend=\"template\"}[5m]) / (rate(llm_call_success_total{backend=\"template\"}[5m]) + rate(llm_call_failure_total{backend=\"template\"}[5m]))",
          "legendFormat": "Template",
          "refId": "C"
        }
      ],
      "yaxes": [
        {
          "format": "percentunit",
          "label": "Success Rate",
          "max": 1,
          "min": 0
        }
      ],
      "legend": {"show": true, "alignAsTable": true, "avg": true}
    },
    {
      "id": 15,
      "title": "LLM调用耗时 (P95)",
      "type": "graph",
      "gridPos": {"x": 12, "y": 42, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(llm_call_duration_seconds_bucket{backend=\"deepseek\"}[5m]))",
          "legendFormat": "DeepSeek P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(llm_call_duration_seconds_bucket{backend=\"ollama\"}[5m]))",
          "legendFormat": "Ollama P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, rate(llm_call_duration_seconds_bucket{backend=\"deepseek\"}[5m]))",
          "legendFormat": "DeepSeek P50",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "s", "label": "Duration"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true, "max": true}
    },
    {
      "id": 16,
      "title": "LLM降级事件统计",
      "type": "graph",
      "gridPos": {"x": 0, "y": 50, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(llm_fallback_total{from=\"deepseek\", to=\"ollama\"}[5m])",
          "legendFormat": "DeepSeek → Ollama",
          "refId": "A"
        },
        {
          "expr": "rate(llm_fallback_total{from=\"ollama\", to=\"template\"}[5m])",
          "legendFormat": "Ollama → Template",
          "refId": "B"
        },
        {
          "expr": "rate(llm_fallback_total{from=\"deepseek\", to=\"template\"}[5m])",
          "legendFormat": "DeepSeek → Template",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "ops", "label": "Fallbacks/sec"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true, "total": true}
    },
    {
      "id": 17,
      "title": "LLM Token使用统计",
      "type": "graph",
      "gridPos": {"x": 12, "y": 50, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(llm_tokens_total{type=\"prompt\"}[5m])",
          "legendFormat": "Prompt Tokens",
          "refId": "A"
        },
        {
          "expr": "rate(llm_tokens_total{type=\"completion\"}[5m])",
          "legendFormat": "Completion Tokens",
          "refId": "B"
        },
        {
          "expr": "rate(llm_tokens_total{type=\"total\"}[5m])",
          "legendFormat": "Total Tokens",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "short", "label": "Tokens/sec"}],
      "legend": {"show": true, "alignAsTable": true, "avg": true, "total": true}
    },
    {
      "id": 18,
      "title": "并发限流统计",
      "type": "graph",
      "gridPos": {"x": 0, "y": 58, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "concurrency_limiter_active_requests",
          "legendFormat": "活跃请求",
          "refId": "A"
        },
        {
          "expr": "concurrency_limiter_queued_requests",
          "legendFormat": "队列中请求",
          "refId": "B"
        },
        {
          "expr": "concurrency_limiter_max_concurrent",
          "legendFormat": "最大并发数",
          "refId": "C"
        }
      ],
      "yaxes": [{"format": "short", "label": "Requests"}],
      "legend": {"show": true, "alignAsTable": true, "current": true, "max": true}
    },
    {
      "id": 19,
      "title": "429错误率 (并发超限)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 58, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "rate(http_requests_total{status=\"429\"}[5m]) / rate(http_requests_total[5m])",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 0.01, "color": "yellow"},
              {"value": 0.05, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 20,
      "title": "平均队列等待时间",
      "type": "stat",
      "gridPos": {"x": 18, "y": 58, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "avg(concurrency_limiter_queue_wait_time_seconds)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 5, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      }
    }
  ]
}
