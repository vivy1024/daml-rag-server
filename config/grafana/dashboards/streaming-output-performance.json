{
  "title": "流式输出性能监控",
  "tags": ["streaming", "performance", "sse"],
  "timezone": "browser",
  "schemaVersion": 16,
  "version": 4,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "流式会话成功率",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(streaming_session_success_total) / (sum(streaming_session_success_total) + sum(streaming_session_failure_total))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.95, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "平均首字节响应时间 (TTFB)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "streaming_session_ttfb_seconds_sum / streaming_session_ttfb_seconds_count",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 2, "color": "yellow" },
              { "value": 3, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "总会话数",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "streaming_session_success_total + streaming_session_failure_total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "失败会话数",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "streaming_session_failure_total",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 10, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "TTFB 趋势 (P50, P95, P99)",
      "type": "graph",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(streaming_session_ttfb_seconds_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(streaming_session_ttfb_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(streaming_session_ttfb_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "yaxes": [{ "format": "s", "label": "TTFB" }]
    },
    {
      "id": 6,
      "title": "会话持续时间趋势 (P50, P95, P99)",
      "type": "graph",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(streaming_session_duration_seconds_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(streaming_session_duration_seconds_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(streaming_session_duration_seconds_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "yaxes": [{ "format": "s", "label": "Duration" }]
    },
    {
      "id": 7,
      "title": "流式会话计数趋势",
      "type": "graph",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(streaming_session_success_total[5m]) + rate(streaming_session_failure_total[5m])",
          "legendFormat": "总会话数",
          "refId": "A"
        },
        {
          "expr": "rate(streaming_session_success_total[5m])",
          "legendFormat": "成功会话",
          "refId": "B"
        },
        {
          "expr": "rate(streaming_session_failure_total[5m])",
          "legendFormat": "失败会话",
          "refId": "C"
        }
      ],
      "yaxes": [{ "format": "short", "label": "Sessions/sec" }]
    },
    {
      "id": 8,
      "title": "令牌生成速率趋势 (P50, P95, P99)",
      "type": "graph",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(streaming_session_tokens_per_second_bucket[5m]))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(streaming_session_tokens_per_second_bucket[5m]))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(streaming_session_tokens_per_second_bucket[5m]))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "yaxes": [{ "format": "short", "label": "Tokens/sec" }]
    },
    {
      "id": 9,
      "title": "累计统计",
      "type": "stat",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 4 },
      "targets": [
        {
          "expr": "streaming_session_success_total + streaming_session_failure_total",
          "legendFormat": "总会话数",
          "refId": "A"
        },
        {
          "expr": "streaming_session_success_total",
          "legendFormat": "成功会话",
          "refId": "B"
        },
        {
          "expr": "streaming_session_failure_total",
          "legendFormat": "失败会话",
          "refId": "C"
        },
        {
          "expr": "streaming_session_ttfb_seconds_count",
          "legendFormat": "TTFB采样数",
          "refId": "D"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "time_range",
        "type": "interval",
        "query": "5m,15m,30m,1h,6h,12h,1d",
        "current": { "text": "5m", "value": "5m" }
      }
    ]
  }
}
