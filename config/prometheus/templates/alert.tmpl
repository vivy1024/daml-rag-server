{{ define "__alert_severity_prefix" -}}
    {{ if eq .Labels.severity "critical" -}}
        🔴 严重
    {{- else if eq .Labels.severity "warning" -}}
        🟡 警告
    {{- else -}}
        🔵 信息
    {{- end }}
{{- end }}

{{ define "__alert_category_emoji" -}}
    {{ if eq .Labels.category "performance" -}}
        ⚡
    {{- else if eq .Labels.category "resource" -}}
        💾
    {{- else if eq .Labels.category "concurrency" -}}
        🔀
    {{- else if eq .Labels.category "availability" -}}
        🚨
    {{- else if eq .Labels.category "reliability" -}}
        🔧
    {{- else -}}
        📊
    {{- end }}
{{- end }}

{{ define "alert.title" -}}
    {{ template "__alert_severity_prefix" . }} {{ template "__alert_category_emoji" . }} {{ .Labels.alertname }}
{{- end }}

{{ define "alert.text" -}}
{{ range .Alerts }}
